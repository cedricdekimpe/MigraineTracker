<% content_for :title, t('home.tagline') %>
<% content_for :description, t('home.description') %>

<% unless user_signed_in? %>
  <%# First thing a visitor sees: log the crisis they are having, before anything is explained. %>
  <section class="mx-auto w-full max-w-xl py-2 sm:py-6" aria-labelledby="crisis-title">
    <h1 id="crisis-title" class="text-3xl font-semibold tracking-tight"><%= t("now.start_title") %></h1>

    <%= render "now/form", url: guest_episode_path, default_pain_kind: "migraine" %>
  </section>

  <hr class="mx-auto my-10 w-full max-w-xl border-ink-200">
<% end %>

<article class="mx-auto max-w-xl space-y-5 text-center" itemscope itemtype="https://schema.org/SoftwareApplication">
  <header>
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">Migraine Tracker</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink-900" itemprop="name"><%= t('home.tagline') %></h2>
    <p class="mt-2 text-base text-ink-600" itemprop="description"><%= t('home.description') %></p>
  </header>

  <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-ink-800">
    <% %w[calendars medication secure].each do |key| %>
      <li itemprop="featureList"><%= t("home.feature_#{key}_title") %></li>
    <% end %>
  </ul>

</article>
