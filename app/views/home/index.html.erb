<% content_for :title, t('home.tagline') %>
<% content_for :description, t('home.description') %>

<article class="mx-auto flex max-w-5xl flex-col gap-12" itemscope itemtype="https://schema.org/SoftwareApplication">
  <header class="text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">Migraine Tracker</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink-900 sm:text-5xl" itemprop="name"><%= t('home.tagline') %></h1>
    <p class="mt-4 text-lg leading-7 text-ink-600" itemprop="description">
      <%= t('home.description') %>
    </p>
    <p class="mt-2 text-xs text-ink-500"><%= t('home.disclaimer') %></p>
  </header>

  <section class="grid gap-8 rounded-3xl border border-ink-200 bg-paper p-8 sm:grid-cols-3">
    <article itemscope itemtype="https://schema.org/Feature">
      <h2 class="text-base font-semibold text-ink-900" itemprop="name"><%= t('home.feature_calendars_title') %></h2>
      <p class="mt-2 text-sm leading-6 text-ink-600" itemprop="description">
        <%= t('home.feature_calendars_desc') %>
      </p>
    </article>
    <article itemscope itemtype="https://schema.org/Feature">
      <h2 class="text-base font-semibold text-ink-900" itemprop="name"><%= t('home.feature_medication_title') %></h2>
      <p class="mt-2 text-sm leading-6 text-ink-600" itemprop="description">
        <%= t('home.feature_medication_desc') %>
      </p>
    </article>
    <article itemscope itemtype="https://schema.org/Feature">
      <h2 class="text-base font-semibold text-ink-900" itemprop="name"><%= t('home.feature_secure_title') %></h2>
      <p class="mt-2 text-sm leading-6 text-ink-600" itemprop="description">
        <%= t('home.feature_secure_desc') %>
      </p>
    </article>
  </section>

  <div class="flex flex-col items-center gap-6 rounded-3xl bg-accent-50 p-8 text-center">
    <h2 class="text-2xl font-semibold text-accent-900"><%= t('home.cta_title') %></h2>
    <p class="max-w-2xl text-base leading-relaxed text-accent-800">
      <%= t('home.cta_description') %>
    </p>

    <% if user_signed_in? %>
      <div class="flex flex-wrap justify-center gap-3">
        <%= link_to t('home.view_calendar'), episodes_path, class: "rounded-xl bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-700" %>
        <%= link_to t('home.manage_medications'), account_medications_path, class: "rounded-xl border border-accent-200 bg-paper px-4 py-2 text-sm font-medium text-accent-700 transition hover:border-accent-300 hover:text-accent-900" %>
      </div>
    <% else %>
      <div class="flex flex-wrap justify-center gap-3">
        <%= link_to t('navigation.create_account'), new_user_registration_path, class: "rounded-xl bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-700" %>
        <%= link_to t('navigation.sign_in'), new_user_session_path, class: "rounded-xl border border-ink-300 bg-paper px-4 py-2 text-sm font-medium text-ink-700 transition hover:border-ink-400 hover:text-ink-900" %>
      </div>
    <% end %>
  </div>
</article>
