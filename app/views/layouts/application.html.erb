<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= seo_title(content_for(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <%# SEO Meta Tags %>
    <meta name="description" content="<%= seo_description %>">
    <meta name="keywords" content="<%= t('seo.keywords', default: 'migraine tracker, headache tracker, migraine diary, health tracking, migraine management') %>">
    <meta name="author" content="<%= t('seo.site_name', default: 'Migraine Tracker') %>">
    <meta name="robots" content="<%= content_for(:robots) || 'index, follow' %>">
    
    <%# GEO Meta Tags - For Generative Engine Optimization %>
    <meta name="generator" content="Rails <%= Rails.version %>">
    <meta name="language" content="<%= I18n.locale %>">
    <meta name="geo.region" content="<%= I18n.locale == :fr ? 'FR' : 'US' %>">
    <meta name="rating" content="General">
    
    <%# Canonical URL %>
    <link rel="canonical" href="<%= canonical_url %>">
    
    <%# Alternate language versions (hreflang) %>
    <% alternate_locales.each do |alt| %>
      <link rel="alternate" hreflang="<%= alt[:locale] %>" href="<%= alt[:url] %>">
    <% end %>
    <link rel="alternate" hreflang="x-default" href="<%= root_url(locale: I18n.default_locale, only_path: false) %>">
    
    <%# Open Graph / Facebook %>
    <meta property="og:type" content="<%= seo_type %>">
    <meta property="og:title" content="<%= seo_title(content_for(:title)) %>">
    <meta property="og:description" content="<%= seo_description %>">
    <meta property="og:url" content="<%= seo_url %>">
    <meta property="og:image" content="<%= seo_image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="<%= t('seo.site_name', default: 'Migraine Tracker') %>">
    <meta property="og:locale" content="<%= I18n.locale == :fr ? 'fr_FR' : 'en_US' %>">
    <% alternate_locales.each do |alt| %>
      <meta property="og:locale:alternate" content="<%= alt[:locale] == :fr ? 'fr_FR' : 'en_US' %>">
    <% end %>
    
    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seo_title(content_for(:title)) %>">
    <meta name="twitter:description" content="<%= seo_description %>">
    <meta name="twitter:image" content="<%= seo_image %>">
    
    <%# Mobile App Meta Tags %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t('seo.site_name', default: 'Migraine Tracker') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#fbf7ef" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#14131a" media="(prefers-color-scheme: dark)">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Structured Data (JSON-LD) %>
    <script type="application/ld+json">
      <%= raw structured_data_organization.to_json %>
    </script>
    <script type="application/ld+json">
      <%= raw structured_data_webapp.to_json %>
    </script>

    <%# Apply the pinned theme before first paint (no flash). "auto" follows the system. %>
    <script>
      try { var t = localStorage.getItem("theme"); if (t === "light" || t === "night") document.documentElement.dataset.theme = t } catch (e) {}
    </script>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col" data-controller="theme" <%= 'data-theme=night' if controller_name == 'now' %>>
    <header class="border-b border-ink-200 bg-paper/80">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <%= link_to root_path, class: "flex items-center gap-3" do %>
          <span class="month-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="font-display text-xl font-semibold tracking-tight text-ink-900">Migraine Tracker</span>
        <% end %>

        <nav class="flex items-center gap-1 text-sm">
          <% if user_signed_in? %>
            <div class="hidden items-center gap-1 md:flex">
              <%= link_to t("navigation.migraine_log"), episodes_path, class: "rounded-xl px-3 py-2 font-medium text-ink-700 transition hover:bg-ink-100" %>
              <%= link_to t("navigation.statistics"), stats_path, class: "rounded-xl px-3 py-2 font-medium text-ink-700 transition hover:bg-ink-100" %>
              <%= link_to t("navigation.account"), account_path, class: "rounded-xl px-3 py-2 font-medium text-ink-700 transition hover:bg-ink-100" %>
              <%= link_to (ongoing_episode ? t("now.in_progress") : t("now.nav")), now_path, class: "ml-2 rounded-xl bg-accent-600 px-4 py-2 font-semibold text-white transition hover:bg-accent-700" %>
            </div>
          <% else %>
            <%= link_to t("navigation.sign_in"), new_user_session_path, class: "rounded-xl px-3 py-2 font-medium text-ink-700 transition hover:bg-ink-100" %>
            <%= link_to t("navigation.create_account"), new_user_registration_path, class: "rounded-xl bg-accent-600 px-4 py-2 font-semibold text-white transition hover:bg-accent-700" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="mx-auto flex w-full max-w-4xl flex-1 flex-col gap-6 px-5 py-8 <%= 'pb-32 md:pb-10' if user_signed_in? && controller_name != 'now' %>">
      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <% tone = type.to_sym == :alert ? "border-red-200 bg-red-50 text-red-700" : "border-accent-200 bg-accent-50 text-accent-800" %>
        <div class="rounded-xl border px-4 py-3 text-sm <%= tone %>" role="alert">
          <p class="font-medium"><%= message %></p>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="border-t border-ink-200 <%= 'pb-24 md:pb-0' if user_signed_in? && controller_name != 'now' %>">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-5 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span>© <%= Time.current.year %> Migraine Tracker</span>
          <%= link_to t("navigation.faq"), faq_path, class: "hover:text-ink-800" %>
          <%= link_to t("navigation.privacy"), privacy_path, class: "hover:text-ink-800" %>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-1" role="group" aria-label="<%= t('theme.label') %>">
            <% [["auto", t("theme.auto")], ["light", t("theme.light")], ["night", t("theme.night")]].each do |value, label| %>
              <button type="button" data-theme-target="button" data-theme-value-param="<%= value %>" data-action="theme#set"
                      class="rounded-lg px-2 py-1 font-medium text-ink-600 hover:bg-ink-100 aria-pressed:bg-ink-200 aria-pressed:text-ink-900"><%= label %></button>
            <% end %>
          </div>
          <div class="flex items-center gap-1">
            <%= link_to "EN", url_for(locale: :en), class: "rounded-lg px-2 py-1 font-medium #{I18n.locale == :en ? 'bg-ink-200 text-ink-900' : 'text-ink-600 hover:bg-ink-100'}" %>
            <%= link_to "FR", url_for(locale: :fr), class: "rounded-lg px-2 py-1 font-medium #{I18n.locale == :fr ? 'bg-ink-200 text-ink-900' : 'text-ink-600 hover:bg-ink-100'}" %>
          </div>
        </div>
      </div>
      <p class="mx-auto max-w-6xl px-5 pb-5 text-xs text-ink-500"><%= t("common.disclaimer") %></p>
    </footer>

    <%# Phone tab bar: the calendar, the big "now" button, the stats, the account %>
    <% if user_signed_in? && controller_name != "now" %>
      <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-200 bg-paper md:hidden" aria-label="<%= t('navigation.primary') %>">
        <div class="mx-auto grid max-w-md grid-cols-[1fr_auto_1fr_1fr] items-end px-2 pb-2 pt-1">
          <%= link_to episodes_path, class: "flex flex-col items-center gap-0.5 rounded-xl py-2 text-xs font-medium #{controller_name == 'episodes' ? 'text-accent-700' : 'text-ink-600'}" do %>
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
            <%= t("navigation.journal") %>
          <% end %>

          <%= link_to now_path, class: "mx-3 -mt-6 flex h-16 w-16 flex-col items-center justify-center rounded-full border-4 border-paper bg-accent-600 text-white transition active:bg-accent-800", "aria-label": (ongoing_episode ? t("now.in_progress") : t("now.nav")) do %>
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z"/></svg>
          <% end %>

          <%= link_to stats_path, class: "flex flex-col items-center gap-0.5 rounded-xl py-2 text-xs font-medium #{controller_name == 'stats' ? 'text-accent-700' : 'text-ink-600'}" do %>
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>
            <%= t("navigation.statistics") %>
          <% end %>

          <%= link_to account_path, class: "flex flex-col items-center gap-0.5 rounded-xl py-2 text-xs font-medium #{controller_name.in?(%w[account registrations triggers medications]) ? 'text-accent-700' : 'text-ink-600'}" do %>
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>
            <%= t("navigation.account") %>
          <% end %>
        </div>
      </nav>
    <% end %>
  </body>
</html>
