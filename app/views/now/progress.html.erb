<% content_for :title, t("now.in_progress") %>

<section class="py-2 sm:py-6">
  <p class="text-sm uppercase tracking-wide text-ink-500"><%= t("now.in_progress") %></p>
  <h1 class="mt-1 text-3xl font-semibold"><%= episode_kind_label(@episode) %></h1>
  <p class="mt-1 text-ink-600">
    <%= t("now.since", time: @episode.started_time.strftime("%H:%M")) %>
    · <%= duration_label([((Time.current - @episode.started_at) / 60).round, 1].max) %>
  </p>

  <% if @episode.pain? %>
    <div class="mt-6">
      <h2 class="mb-3 text-lg font-medium"><%= t("now.intensity_now") %></h2>
      <%= form_with url: now_intensity_path, method: :patch, data: { turbo: false } do %>
        <div class="grid grid-cols-5 gap-3">
          <% (1..10).each do |value| %>
            <%= button_tag value, type: "submit", name: "intensity", value: value,
                  class: "min-h-14 cursor-pointer rounded-2xl border text-xl font-semibold transition #{value == @episode.intensity ? 'border-accent-400 bg-accent-600 text-white' : 'border-ink-200 bg-ink-100 text-ink-900 hover:border-accent-400'}" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8">
    <h2 class="mb-3 text-lg font-medium"><%= t("now.medication") %></h2>
    <% if @episode.medication_intakes.any? %>
      <ul class="mb-4 space-y-1 text-ink-800">
        <% @episode.medication_intakes.each do |intake| %>
          <li>✓ <%= [intake.medication.name, intake.dose].compact_blank.join(" ") %> <span class="text-ink-500">· <%= intake.taken_time&.strftime("%H:%M") %></span></li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with url: now_medication_path, method: :post, data: { turbo: false } do %>
      <div class="flex flex-wrap gap-3">
        <% @medications.each do |medication| %>
          <%= button_tag [medication.name, medication.default_dose].compact_blank.join(" "), type: "submit", name: "medication_id", value: medication.id,
                class: "min-h-14 cursor-pointer rounded-2xl border border-ink-200 bg-ink-100 px-5 text-lg text-ink-900 transition hover:border-accent-400 active:bg-accent-600" %>
        <% end %>
      </div>
    <% end %>
    <% if @medications.empty? %>
      <p class="mb-3 text-sm text-ink-500"><%= t("now.no_medication") %></p>
    <% end %>
    <% if @medications.empty? %>
      <%= form_with url: now_medication_path, method: :post, data: { turbo: false }, class: "mb-3 flex flex-wrap gap-3" do %>
        <% @suggested_medications.each do |name| %>
          <%= button_tag name, type: "submit", name: "name", value: name,
                class: "min-h-14 cursor-pointer rounded-2xl border border-dashed border-ink-300 bg-ink-100 px-5 text-lg text-ink-900 transition hover:border-accent-400 active:bg-accent-600" %>
        <% end %>
      <% end %>
    <% end %>
    <%= form_with url: now_medication_path, method: :post, data: { turbo: false }, class: "mt-3 flex gap-2" do %>
      <%= text_field_tag :name, nil, placeholder: t("episodes.add_medication"), "aria-label": t("episodes.add_medication"),
            class: "min-h-12 min-w-0 flex-1 rounded-2xl border border-ink-300 bg-paper px-4 text-base text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500" %>
      <%= button_tag t("account.add"), type: "submit", class: "min-h-12 cursor-pointer rounded-2xl border border-ink-300 px-5 text-base font-medium text-ink-800 hover:border-accent-400" %>
    <% end %>
    <% if @medications.any? %>
      <p class="mt-2 text-xs text-ink-500"><%= link_to t("episodes.manage_medications"), account_medications_path, class: "underline" %></p>
    <% end %>
  </div>

  <%= button_to t("now.finish"), now_finish_path, method: :patch, data: { turbo: false },
        class: "mt-10 min-h-16 w-full cursor-pointer rounded-2xl bg-accent-600 text-xl font-semibold text-white transition hover:bg-accent-500",
        form: { class: "w-full" } %>

  <div class="mt-6 flex items-center justify-between text-sm">
    <%= link_to t("now.add_details"), edit_episode_path(id: @episode), class: "text-ink-500 underline hover:text-ink-800" %>
    <%= button_to t("now.cancel"), now_path, method: :delete, data: { turbo: false, turbo_confirm: t("now.confirm_cancel") },
          class: "cursor-pointer text-ink-500 underline hover:text-ink-800", form: { class: "inline" } %>
  </div>
</section>
