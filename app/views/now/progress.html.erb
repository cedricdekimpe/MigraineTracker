<% content_for :title, t("now.in_progress") %>

<section class="py-2 sm:py-6">
  <p class="text-sm uppercase tracking-wide text-fg-muted"><%= t("now.in_progress") %></p>
  <h1 class="mt-1 text-3xl font-semibold"><%= episode_kind_label(@episode) %></h1>
  <p class="mt-1 text-fg-secondary">
    <%= t("now.since", time: @episode.started_time.strftime("%H:%M")) %>
    · <%= duration_label([((Time.current - @episode.started_at) / 60).round, 1].max) %>
  </p>

  <%# Left open for hours (often forgotten): say when it ended, so the duration stays right %>
  <% if Time.current - @episode.started_at >= OngoingChecks::AFTER %>
    <%= form_with url: now_finish_path, method: :patch, data: { turbo: false, still_going: true }, class: "mt-4 rounded-2xl border border-line-control p-4" do %>
      <h2 class="text-lg font-medium"><%= t("now.still_going") %></h2>
      <%= label_tag :ended_at, t("now.ended_at"), class: "mt-2 block text-base text-fg-secondary" %>
      <div class="mt-2 flex flex-wrap gap-3">
        <%= datetime_local_field_tag :ended_at, Time.current.strftime("%Y-%m-%dT%H:%M"), min: @episode.started_at.strftime("%Y-%m-%dT%H:%M"), max: Time.current.strftime("%Y-%m-%dT%H:%M"),
              class: "min-h-12 rounded-2xl border border-line-control bg-surface px-4 text-base text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
        <%= button_tag t("now.ended_save"), type: "submit", class: "min-h-12 cursor-pointer rounded-2xl border border-line-control px-5 text-base font-medium text-fg hover:border-accent-400" %>
      </div>
    <% end %>
  <% end %>

  <% if @episode.long_attack? %>
    <div class="mt-4"><%= render "episodes/long_attack_note" %></div>
  <% end %>

  <% if @episode.pain? %>
    <div class="mt-6">
      <h2 class="mb-3 text-lg font-medium"><%= t("now.intensity_now") %></h2>
      <%= form_with url: now_intensity_path, method: :patch, data: { turbo: false } do %>
        <div class="grid grid-cols-5 gap-3">
          <% (1..10).each do |value| %>
            <%= button_tag value, type: "submit", name: "intensity", value: value,
                  class: "min-h-14 cursor-pointer rounded-2xl border text-xl font-semibold transition #{value == @episode.intensity ? 'border-accent-400 bg-primary text-primary-on' : 'border-line-control bg-surface-soft text-fg hover:border-accent-400'}" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8">
    <h2 class="mb-3 text-lg font-medium"><%= t("now.medication") %></h2>
    <% if @episode.medication_intakes.any? %>
      <ul class="mb-4 space-y-1 text-fg">
        <% @episode.medication_intakes.each do |intake| %>
          <% label = [intake.medication.name, intake.dose].compact_blank.join(" ") %>
          <li class="flex items-center justify-between gap-3">
            <span>✓ <%= label %> <span class="text-fg-muted">· <%= intake.taken_time&.strftime("%H:%M") %></span></span>
            <%= button_to t("now.remove_intake"), now_intake_path(id: intake), method: :delete, data: { turbo: false },
                  "aria-label": t("now.remove_intake_named", name: label), form: { class: "shrink-0" },
                  class: "min-h-11 cursor-pointer px-2 text-sm text-fg-muted underline hover:text-fg" %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with url: now_medication_path, method: :post, data: { turbo: false } do %>
      <div class="flex flex-wrap gap-3">
        <% @medications.each do |medication| %>
          <%= button_tag [medication.name, medication.default_dose].compact_blank.join(" "), type: "submit", name: "medication_id", value: medication.id,
                class: "min-h-14 cursor-pointer rounded-2xl border border-line-control bg-surface-soft px-5 text-lg text-fg transition hover:border-accent-400 active:bg-primary" %>
        <% end %>
      </div>
    <% end %>
    <% if @unknown_name %>
      <%= form_with url: now_medication_path, method: :post, data: { turbo: false }, class: "mb-4 rounded-2xl border border-line-control p-4" do %>
        <p class="mb-3 text-base font-medium"><%= t("now.kind_question", name: @unknown_name) %></p>
        <%= hidden_field_tag :name, @unknown_name %>
        <div class="grid gap-2">
          <% %w[triptan acute combination gepant other].each do |kind| %>
            <%= button_tag t("medications_page.kinds.#{kind}"), type: "submit", name: "kind", value: kind,
                  class: "min-h-12 cursor-pointer rounded-2xl border border-line-control bg-surface-soft px-4 text-left text-base text-fg hover:border-accent-400" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% if @medications.empty? %>
      <%= form_with url: now_medication_path, method: :post, data: { turbo: false }, class: "mb-3 flex flex-wrap gap-3" do %>
        <% @suggested_medications.each do |name| %>
          <%= button_tag name, type: "submit", name: "name", value: name,
                class: "min-h-14 cursor-pointer rounded-2xl border border-dashed border-line-control bg-surface-soft px-5 text-lg text-fg transition hover:border-accent-400 active:bg-primary" %>
        <% end %>
      <% end %>
    <% end %>
    <%= form_with url: now_medication_path, method: :post, data: { turbo: false }, class: "mt-3 flex gap-2" do %>
      <%= text_field_tag :name, nil, placeholder: t("episodes.add_medication"), "aria-label": t("episodes.add_medication"),
            class: "min-h-12 min-w-0 flex-1 rounded-2xl border border-line-control bg-surface px-4 text-base text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      <%= button_tag t("account.add"), type: "submit", class: "min-h-12 cursor-pointer rounded-2xl border border-line-control px-5 text-base font-medium text-fg hover:border-accent-400" %>
    <% end %>
    <% if @medications.any? %>
      <p class="mt-2 text-xs text-fg-muted"><%= link_to t("episodes.manage_medications"), account_medications_path, class: "underline" %></p>
    <% end %>
  </div>

  <%= button_to t("now.finish"), now_finish_path, method: :patch, data: { turbo: false },
        class: "mt-10 min-h-16 w-full cursor-pointer rounded-2xl bg-primary text-xl font-semibold text-primary-on transition hover:bg-primary-hover",
        form: { class: "w-full" } %>

  <div class="mt-6 flex items-center justify-between text-sm">
    <%= link_to t("now.add_details"), edit_episode_path(id: @episode), class: "text-fg-muted underline hover:text-fg" %>
    <%= button_to t("now.cancel"), now_path, method: :delete, data: { turbo: false, turbo_confirm: t("now.confirm_cancel") },
          class: "cursor-pointer text-fg-muted underline hover:text-fg", form: { class: "inline" } %>
  </div>
</section>
