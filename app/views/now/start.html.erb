<% content_for :title, t("now.nav") %>

<%# Dark, low-contrast and oversized on purpose: this is used during an attack. %>
<section class="py-2 sm:py-6">
  <h1 class="text-2xl font-semibold"><%= t("now.start_title") %></h1>

  <%= render "now/form", url: now_path, default_pain_kind: @default_pain_kind %>

  <p class="mt-6 text-center text-sm">
    <%= link_to t("now.fill_form"), new_episode_path, class: "text-fg-muted underline hover:text-fg" %>
  </p>
  <p class="mt-3 text-center text-xs text-fg-muted"><%= link_to t("urgent.link"), urgent_path, class: "underline" %></p>
</section>
