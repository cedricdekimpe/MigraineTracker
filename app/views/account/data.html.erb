<% content_for :title, t('account.data_page_title') %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 lg:flex-row">
  <%# Sidebar Navigation %>
  <aside class="lg:w-64 lg:shrink-0">
    <%# Phones: a row of tabs above the page; wide screens: the sidebar card %>
    <div class="lg:rounded-2xl lg:border lg:border-line lg:bg-surface lg:p-4">
      <h2 class="mb-4 hidden px-3 text-xs font-semibold uppercase tracking-wider text-fg-muted lg:block"><%= t('account.settings') %></h2>
      <%= render 'account/navigation' %>
    </div>
  </aside>

  <%# Main Content %>
  <main class="flex-1 space-y-6">
    <%# Data Management Section %>
    <div class="rounded-2xl border border-line bg-surface p-5 sm:p-8">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold text-fg"><%= t('account.data_management_title') %></h1>
      </header>

      <%# Export and import: two flat sections in the one card, no boxes inside boxes %>
      <div class="divide-y divide-line">
        <section class="pb-6">
          <h2 class="text-lg font-semibold text-fg"><%= t('account.export_title') %></h2>
          <p class="mt-1 text-sm text-fg-secondary"><%= t('account.export_description') %></p>
          <%= button_to t('account.export_button'), exports_path, method: :post, data: { turbo: false },
                class: "mt-4 min-h-11 w-full cursor-pointer rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover sm:w-auto" %>
        </section>

        <section class="pt-6">
          <h2 class="text-lg font-semibold text-fg"><%= t('account.import_title') %></h2>
          <p class="mt-1 text-sm text-fg-secondary"><%= t('account.import_description') %></p>
          <%= link_to t('account.import_button'), new_import_path,
                class: "mt-4 flex min-h-11 w-full items-center justify-center rounded-lg border border-accent-600 bg-surface px-4 py-2 text-center text-sm font-semibold text-link transition hover:bg-surface-soft sm:inline-flex sm:w-auto" %>
        </section>
      </div>
    </div>

    <%# Danger zone: one tinted card, the warning and the button directly in it %>
    <div data-controller="account-deletion" data-account-deletion-confirmation-phrase-value="<%= t('account.delete_confirmation_phrase') %>">
      <section class="rounded-2xl border border-red-300 bg-over-surface p-5 sm:p-8">
        <h2 class="text-xl font-semibold text-over-text"><%= t('account.danger_zone_title') %></h2>
        <h3 class="mt-4 font-medium text-over-text"><%= t('account.delete_account_title') %></h3>
        <p class="mt-1 text-sm text-over-text"><%= t('account.delete_account_warning') %></p>
        <p class="mt-2 text-sm text-over-text">
          <%= t('account.data_to_delete') %>
          <strong><%= t('account.migraines_count', count: current_user.episodes.count) %></strong>,
          <strong><%= t('account.medications_count', count: current_user.medications.count) %></strong>,
          <%= t('account.rest_of_journal') %>
        </p>
        <button type="button" data-action="click->account-deletion#open"
                class="mt-4 min-h-11 w-full cursor-pointer rounded-lg border border-red-400 bg-surface px-4 py-2 text-sm font-semibold text-over-text transition hover:bg-surface-soft sm:w-auto">
          <%= t('account.delete_my_account') %>
        </button>
      </section>

      <%# Account Deletion Modal %>
      <div data-account-deletion-target="modal" 
           data-action="click->account-deletion#closeBackground keydown.esc@window->account-deletion#close"
           class="hidden fixed inset-0 z-50 flex items-center justify-center bg-ink-900/50 p-4">
        <div class="w-full max-w-md rounded-2xl border border-line bg-surface p-6"
             data-action="click->account-deletion#stopPropagation">
          <div class="mb-6">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100">
              <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
            </div>
            <h3 class="text-center text-lg font-semibold text-fg"><%= t('account.delete_modal_title') %></h3>
            <p class="mt-2 text-center text-sm text-fg-secondary"><%= t('account.delete_modal_description') %></p>
          </div>

          <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-sm text-red-800">
              <strong><%= t('account.delete_modal_warning') %></strong>
            </p>
            <ul class="mt-2 list-inside list-disc text-sm text-red-700">
              <li><%= t('account.migraines_count', count: current_user.episodes.count) %></li>
              <li><%= t('account.medications_count', count: current_user.medications.count) %></li>
              <li><%= t('account.rest_of_journal') %></li>
              <li><%= t('account.delete_modal_account_info') %></li>
            </ul>
          </div>

          <%= form_with url: registration_path(:user), method: :delete, data: { turbo: false }, class: "space-y-4" do |form| %>
            <div>
              <label class="block text-sm font-medium text-fg-secondary">
                <%= t('account.delete_modal_type_phrase') %>
                <code class="ml-1 rounded bg-surface-soft px-2 py-0.5 text-sm font-bold text-red-600"><%= t('account.delete_confirmation_phrase') %></code>
              </label>
              <input type="text" 
                     data-account-deletion-target="confirmationInput"
                     data-action="input->account-deletion#validateConfirmation"
                     autocomplete="off"
                     class="mt-2 block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500">
            </div>

            <div>
              <label class="block text-sm font-medium text-fg-secondary"><%= t('account.delete_modal_password') %></label>
              <input type="password" 
                     name="password"
                     data-account-deletion-target="passwordInput"
                     data-action="input->account-deletion#validateConfirmation"
                     autocomplete="current-password"
                     class="mt-2 block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500">
            </div>

            <div class="flex gap-3 pt-2">
              <button type="button" 
                      data-action="click->account-deletion#close"
                      class="flex-1 rounded-lg border border-line-control bg-surface px-4 py-2 text-sm font-medium text-fg-secondary transition hover:bg-page">
                <%= t('common.cancel') %>
              </button>
              <button type="submit" 
                      disabled
                      data-account-deletion-target="submitButton"
                      class="flex-1 rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white opacity-50 cursor-not-allowed transition">
                <%= t('account.delete_account_permanently') %>
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>
