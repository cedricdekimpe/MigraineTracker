<% content_for :title, t('account.medications_page_title') %>

<% field = "rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 lg:flex-row">
  <aside class="lg:w-64 lg:shrink-0">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <h2 class="mb-4 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('account.settings') %></h2>
      <%= render 'account/navigation' %>
    </div>
  </aside>

  <main class="flex-1">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold text-slate-900"><%= t('account.medications_title') %></h1>
        <p class="mt-2 text-sm text-slate-500"><%= t('medications_page.description') %></p>
      </header>

      <div class="space-y-6">
        <% if @medications.any? %>
          <ul class="space-y-3">
            <% @medications.each do |medication| %>
              <li class="rounded-lg border border-slate-200 p-4">
                <%= form_with model: medication, url: medication_path(medication), method: :patch, data: { turbo: false }, class: "grid gap-3 sm:grid-cols-[2fr_1fr_1fr_auto] sm:items-end" do |form| %>
                  <div>
                    <%= form.label :name, t('account.medication_name'), class: "block text-xs font-medium text-slate-600" %>
                    <%= form.text_field :name, class: "#{field} w-full" %>
                  </div>
                  <div>
                    <%= form.label :kind, t('medications_page.kind'), class: "block text-xs font-medium text-slate-600" %>
                    <%= form.select :kind, Medication::KINDS.map { |kind| [t("medications_page.kinds.#{kind}"), kind] }, {}, class: "#{field} w-full" %>
                  </div>
                  <div>
                    <%= form.label :default_dose, t('medications_page.default_dose'), class: "block text-xs font-medium text-slate-600" %>
                    <%= form.text_field :default_dose, placeholder: "400 mg", class: "#{field} w-full" %>
                  </div>
                  <%= form.submit t('common.save'), class: "cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-emerald-400 hover:text-emerald-700" %>
                <% end %>
                <div class="mt-3 flex justify-end">
                  <%= button_to t('medications_page.remove'), medication_path(medication), method: :delete,
                        data: { turbo_confirm: t('medications_page.confirm_remove', name: medication.name) },
                        class: "text-xs font-medium text-slate-500 transition hover:text-rose-600" %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="rounded-md border border-dashed border-slate-300 px-4 py-8 text-center">
            <p class="text-sm text-slate-500"><%= t('account.no_medications') %></p>
            <p class="mt-1 text-xs text-slate-400"><%= t('account.no_medications_hint') %></p>
          </div>
        <% end %>

        <% if @suggestions.any? %>
          <div class="border-t border-slate-200 pt-6">
            <h3 class="mb-3 text-sm font-medium text-slate-900"><%= t('episodes.common_medications') %></h3>
            <div class="flex flex-wrap gap-2">
              <% @suggestions.each do |name, kind| %>
                <%= button_to name, medications_path, params: { medication: { name: name, kind: kind } }, method: :post, form: { data: { turbo: false } },
                      class: "cursor-pointer rounded-full border border-dashed border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-700 transition hover:border-emerald-400 hover:text-emerald-700" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="border-t border-slate-200 pt-6">
          <h3 class="mb-4 text-sm font-medium text-slate-900"><%= t('account.add_new_medication') %></h3>
          <%= form_with model: Medication.new, url: medications_path, data: { turbo: false }, class: "grid gap-3 sm:grid-cols-[2fr_1fr_1fr_auto]" do |form| %>
            <%= form.label :name, t('account.medication_name'), class: "sr-only" %>
            <%= form.text_field :name, placeholder: t('account.medication_name'), class: field %>
            <%= form.select :kind, Medication::KINDS.map { |kind| [t("medications_page.kinds.#{kind}"), kind] }, {}, "aria-label": t('medications_page.kind'), class: field %>
            <%= form.text_field :default_dose, placeholder: t('medications_page.default_dose'), "aria-label": t('medications_page.default_dose'), class: field %>
            <%= form.submit t('account.add'), class: "cursor-pointer rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700" %>
          <% end %>
        </div>

        <% if @archived_medications.any? %>
          <div class="border-t border-slate-200 pt-6">
            <h3 class="mb-1 text-sm font-medium text-slate-900"><%= t('medications_page.archived') %></h3>
            <p class="mb-3 text-xs text-slate-500"><%= t('medications_page.archived_hint') %></p>
            <ul class="space-y-2">
              <% @archived_medications.each do |medication| %>
                <li class="flex items-center justify-between rounded-lg border border-slate-200 px-4 py-2">
                  <span class="text-sm text-slate-600"><%= medication.name %></span>
                  <%= button_to t('medications_page.restore'), unarchive_medication_path(medication), method: :patch, data: { turbo: false },
                        class: "text-sm font-medium text-emerald-700 hover:text-emerald-800" %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>
