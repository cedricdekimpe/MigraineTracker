<% content_for :title, t('triggers_page.title') %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 lg:flex-row">
  <aside class="lg:w-64 lg:shrink-0">
    <div class="rounded-2xl border border-line bg-surface p-4">
      <h2 class="mb-4 px-3 text-xs font-semibold uppercase tracking-wider text-fg-muted"><%= t('account.settings') %></h2>
      <%= render 'account/navigation' %>
    </div>
  </aside>

  <main class="flex-1">
    <div class="rounded-2xl border border-line bg-surface p-8">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold text-fg"><%= t('triggers_page.title') %></h1>
      </header>

      <ul class="space-y-3">
        <% @triggers.each do |trigger| %>
          <li class="flex items-center justify-between rounded-xl border border-line px-4 py-3">
            <span class="text-sm font-medium text-fg"><%= trigger.name %></span>
            <%= button_to t('common.delete'), trigger_path(trigger), method: :delete,
                  data: { turbo_confirm: t('triggers_page.confirm_delete', name: trigger.name) },
                  class: "rounded-lg border border-line-control bg-surface px-3 py-1.5 text-sm font-medium text-fg-secondary transition hover:border-rose-300 hover:text-rose-600" %>
          </li>
        <% end %>
      </ul>

      <div class="mt-6 border-t border-line pt-6">
        <%= form_with model: Trigger.new, url: triggers_path, data: { turbo: false }, class: "flex flex-col gap-3 sm:flex-row" do |form| %>
          <%= form.label :name, t('triggers_page.name'), class: "sr-only" %>
          <%= form.text_field :name, placeholder: t('triggers_page.name'), class: "flex-1 rounded-lg border border-line-control px-3 py-2 text-sm text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
          <%= form.submit t('account.add'), class: "cursor-pointer rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover" %>
        <% end %>
      </div>
    </div>
  </main>
</div>
