<% content_for :title, t('account.profile_title') %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 lg:flex-row">
  <%# Sidebar Navigation %>
  <aside class="lg:w-64 lg:shrink-0">
    <%# Phones: a row of tabs above the page; wide screens: the sidebar card %>
    <div class="lg:rounded-2xl lg:border lg:border-line lg:bg-surface lg:p-4">
      <h2 class="mb-4 hidden px-3 text-xs font-semibold uppercase tracking-wider text-fg-muted lg:block"><%= t('account.settings') %></h2>
      <%= render 'account/navigation' %>
    </div>
  </aside>

  <%# Main Content %>
  <main class="flex flex-1 flex-col gap-6">
    <%# Shown by the install controller only when the browser can install the app and it is not installed yet %>
    <section class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-line bg-surface p-5 sm:px-8" data-controller="install" hidden data-install-section>
      <h2 class="text-lg font-semibold text-fg"><%= t("install.title") %></h2>
      <button type="button" class="min-h-[44px] cursor-pointer rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover" data-install-target="button" data-action="install#install" hidden><%= t("install.button") %></button>
      <p class="w-full text-sm text-fg-secondary" data-install-target="ios" hidden><%= t("install.ios") %></p>
      <p class="w-full text-sm text-fg-secondary" data-install-target="menu" hidden><%= t("install.menu") %></p>
    </section>

    <div class="rounded-2xl border border-line bg-surface p-5 sm:p-8">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold text-fg"><%= t('account.account_info') %></h1>
      </header>

      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), method: :put, data: { turbo: false }, class: "space-y-6" do |form| %>
        <div class="space-y-2">
          <%= form.label :email, t('account.email'), class: "block text-sm font-medium text-fg-secondary" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <%= form.label :password, t('account.password'), class: "block text-sm font-medium text-fg-secondary" %>
            <span class="text-xs text-fg-muted"><%= t('account.password_hint') %></span>
          </div>
          <%= form.password_field :password, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
        </div>

        <div class="space-y-2">
          <%= form.label :password_confirmation, t('account.password_confirmation'), class: "block text-sm font-medium text-fg-secondary" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
        </div>

        <div class="space-y-2">
          <%= form.label :current_password, t('account.current_password'), class: "block text-sm font-medium text-fg-secondary" %>
          <%= form.password_field :current_password, autocomplete: "current-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
          <p class="text-xs text-fg-muted"><%= t('account.current_password_hint') %></p>
        </div>

        <div class="flex items-center justify-end border-t border-line pt-6">
          <%= form.submit t('account.update_account'), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover cursor-pointer" %>
        </div>
      <% end %>

      <section class="mt-10 border-t border-line pt-8">
        <h2 class="text-lg font-semibold text-fg"><%= t('preferences.title') %></h2>
        <%= form_with model: current_user, scope: :user, url: account_preferences_path, method: :patch, data: { turbo: false }, class: "mt-4 space-y-4" do |form| %>
          <div class="flex items-start gap-3">
            <%= form.check_box :track_cycle, class: "mt-1 h-6 w-6 rounded border-line-control text-link focus:ring-focus" %>
            <div>
              <%= form.label :track_cycle, t('preferences.track_cycle'), class: "text-sm font-medium text-fg-secondary" %>
              <%= render "shared/info", text: t('preferences.track_cycle_hint') %>
            </div>
          </div>
          <%= form.submit t('common.save'), class: "cursor-pointer rounded-lg border border-line-control bg-surface px-4 py-2 text-sm font-medium text-fg-secondary transition hover:border-accent-400 hover:text-link" %>
        <% end %>
      </section>
    </div>
  </main>
</div>
