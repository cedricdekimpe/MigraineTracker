<%# Account navigation: tabs that wrap onto a second line on phones (nothing hidden off-screen), a sidebar from lg %>
<nav class="flex flex-wrap gap-1 lg:flex-col">
  <%= link_to account_profile_path, 
      class: "flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap rounded-xl px-3 py-2 text-sm font-medium transition lg:gap-3 #{current_page?(account_profile_path) ? 'bg-ok-surface text-link' : 'text-fg-secondary hover:bg-page hover:text-fg'}" do %>
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </svg>
    <%= t('account.nav.profile') %>
  <% end %>

  <%= link_to account_medications_path, 
      class: "flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap rounded-xl px-3 py-2 text-sm font-medium transition lg:gap-3 #{current_page?(account_medications_path) ? 'bg-ok-surface text-link' : 'text-fg-secondary hover:bg-page hover:text-fg'}" do %>
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
    </svg>
    <%= t('account.nav.medications') %>
  <% end %>

  <%= link_to account_triggers_path,
      class: "flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap rounded-xl px-3 py-2 text-sm font-medium transition lg:gap-3 #{current_page?(account_triggers_path) ? 'bg-ok-surface text-link' : 'text-fg-secondary hover:bg-page hover:text-fg'}" do %>
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>
    <%= t('triggers_page.nav') %>
  <% end %>

  <%= link_to account_data_path, 
      class: "flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap rounded-xl px-3 py-2 text-sm font-medium transition lg:gap-3 #{current_page?(account_data_path) ? 'bg-ok-surface text-link' : 'text-fg-secondary hover:bg-page hover:text-fg'}" do %>
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
    </svg>
    <%= t('account.nav.data') %>
  <% end %>

  <% if Instance.feedback_address %>
    <%= link_to feedback_path,
        class: "flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap rounded-xl px-3 py-2 text-sm font-medium transition lg:gap-3 #{current_page?(feedback_path) ? 'bg-ok-surface text-link' : 'text-fg-secondary hover:bg-page hover:text-fg'}" do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h8M8 14h5m-9 6 3-3h11a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v14Z"/>
      </svg>
      <%= t("feedback.nav") %>
    <% end %>
  <% end %>

  <%= button_to destroy_user_session_path, method: :delete, form: { class: "lg:mt-4 lg:border-t lg:border-line lg:pt-4" },
        class: "flex min-h-11 w-full items-center gap-2 whitespace-nowrap rounded-xl px-3 py-2 text-sm font-medium text-fg-secondary transition hover:bg-surface-soft hover:text-fg lg:gap-3" do %>
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/>
    </svg>
    <%= t('navigation.sign_out') %>
  <% end %>
</nav>
