<%# Dated periods of a preventive medication: when it was started, when and why it was stopped. %>
<% field = "rounded-lg border border-line-control bg-surface px-3 py-2 text-base text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
<% periods = medication.treatment_periods.chronological.to_a %>

<div class="mt-4 border-t border-ink-100 pt-4" data-treatment-periods>
  <h3 class="text-sm font-semibold text-fg"><%= t("treatment_periods.title") %> <%= render "shared/info", text: t("treatment_periods.hint") %></h3>

  <% if periods.empty? %>
    <p class="mt-3 text-sm text-fg-secondary"><%= t("treatment_periods.empty") %></p>
  <% else %>
    <ul class="mt-3 space-y-3">
      <% periods.each do |period| %>
        <li class="rounded-xl bg-page p-3" data-period>
          <p class="text-sm font-medium text-fg">
            <%= l(period.started_on, format: :long) %> → <%= period.current? ? t("treatment_periods.ongoing") : l(period.ended_on, format: :long) %>
            <span class="font-normal text-fg-secondary">· <%= t("treatment_periods.duration", count: period.days) %><%= " · #{period.dose}" if period.dose %></span>
          </p>
          <% if period.stop_reason %>
            <p class="text-xs text-fg-secondary"><%= t("treatment_periods.reasons.#{period.stop_reason}") %></p>
          <% end %>
          <%= form_with model: period, url: medication_treatment_period_path(medication, period), method: :patch, data: { turbo: false }, class: "mt-2 grid gap-2 sm:grid-cols-[1fr_1fr_1fr_auto] sm:items-end" do |form| %>
            <div>
              <%= form.label :ended_on, t("treatment_periods.ended_on"), class: "block text-xs font-medium text-fg-secondary" %>
              <%= form.date_field :ended_on, max: Date.current, class: "#{field} w-full" %>
            </div>
            <div>
              <%= form.label :stop_reason, t("treatment_periods.stop_reason"), class: "block text-xs font-medium text-fg-secondary" %>
              <%= form.select :stop_reason, TreatmentPeriod::STOP_REASONS.map { |reason| [t("treatment_periods.reasons.#{reason}"), reason] }, { include_blank: "—" }, class: "#{field} w-full" %>
            </div>
            <div>
              <%= form.label :dose, t("treatment_periods.dose"), class: "block text-xs font-medium text-fg-secondary" %>
              <%= form.text_field :dose, class: "#{field} w-full" %>
            </div>
            <%= form.submit t("common.save"), class: "cursor-pointer rounded-lg border border-line-control bg-surface px-3 py-2 text-sm font-medium text-fg-secondary hover:border-accent-400" %>
          <% end %>
          <%= button_to t("treatment_periods.remove"), medication_treatment_period_path(medication, period), method: :delete,
                data: { turbo_confirm: t("treatment_periods.confirm_remove") }, class: "mt-2 cursor-pointer text-xs font-medium text-fg-muted hover:text-rose-600" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: TreatmentPeriod.new, url: medication_treatment_periods_path(medication), data: { turbo: false }, class: "mt-3 grid gap-2 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |form| %>
    <div>
      <%= form.label :started_on, t("treatment_periods.started_on"), class: "block text-xs font-medium text-fg-secondary" %>
      <%= form.date_field :started_on, max: Date.current, value: Date.current, required: true, class: "#{field} w-full" %>
    </div>
    <div>
      <%= form.label :dose, t("treatment_periods.dose"), class: "block text-xs font-medium text-fg-secondary" %>
      <%= form.text_field :dose, value: medication.default_dose, placeholder: "80 mg", class: "#{field} w-full" %>
    </div>
    <%= form.submit t("treatment_periods.add"), class: "cursor-pointer rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on hover:bg-primary-hover" %>
  <% end %>
</div>
