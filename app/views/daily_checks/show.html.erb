<% content_for :title, t("daily_check.title") %>
<% chip = "flex min-h-14 cursor-pointer items-center justify-center rounded-2xl border border-line-control bg-surface-soft px-3 text-center text-base leading-tight text-fg peer-checked:border-accent-400 peer-checked:bg-primary peer-checked:text-primary-on peer-focus-visible:ring-2 peer-focus-visible:ring-focus" %>

<section class="mx-auto w-full max-w-xl py-2 sm:py-6">
  <p class="text-sm text-fg-muted"><%= l(@date, format: :long) %></p>
  <h1 class="text-3xl font-semibold tracking-tight"><%= t("daily_check.title") %> <%= render "shared/info", text: t("daily_check.premonitory") %></h1>

  <%= form_with model: @check, url: daily_check_path(date: @date.iso8601), method: :patch, scope: :daily_check, data: { turbo: false }, class: "mt-6 space-y-7" do |form| %>
    <% { sleep: DailyCheck::SLEEPS, stress: DailyCheck::STRESSES, caffeine: DailyCheck::CAFFEINES }.each do |field, values| %>
      <fieldset data-question="<%= field %>">
        <legend class="mb-2 text-lg font-medium"><%= t("daily_check.#{field}.question") %></legend>
        <div class="grid grid-cols-3 gap-2">
          <% values.each do |value| %>
            <label>
              <%= form.radio_button field, value, class: "peer sr-only" %>
              <span class="<%= chip %>"><%= t("daily_check.#{field}.#{value}") %></span>
            </label>
          <% end %>
        </div>
        <% if field == :caffeine %>
          <label class="mt-4 block">
            <%= form.hidden_field :skipped_meal, value: "0", id: nil %>
            <%= form.check_box :skipped_meal, { class: "peer sr-only" }, "1", nil %>
            <span class="<%= chip %> w-full"><%= t("daily_check.skipped_meal") %></span>
          </label>
        <% end %>
      </fieldset>
    <% end %>

    <% if current_user.track_cycle? %>
      <% on_period = current_user.period_days.exists?(date: @date) %>
      <fieldset data-question="period">
        <legend class="mb-2 text-lg font-medium"><%= t("daily_check.period.question") %></legend>
        <div class="grid grid-cols-2 gap-2">
          <% [["yes", on_period], ["no", false]].each do |value, checked| %>
            <label>
              <%= radio_button_tag "period", value, checked, class: "peer sr-only" %>
              <span class="<%= chip %>"><%= t("daily_check.period.#{value}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <%= form.submit t("daily_check.save"), class: "flex min-h-14 w-full cursor-pointer items-center justify-center rounded-2xl bg-primary text-lg font-semibold text-primary-on hover:bg-primary-hover" %>
  <% end %>

  <p class="mt-6 text-sm text-fg-muted">
    <% if @date == Date.current %>
      <%= link_to t("daily_check.yesterday"), daily_check_path(date: (@date - 1).iso8601), class: "underline" %>
    <% elsif @date == Date.current - 1 %>
      <%= link_to t("daily_check.today"), daily_check_path(date: Date.current.iso8601), class: "underline" %>
    <% end %>
  </p>
</section>
