<% content_for :title, t("daily_check.title") %>
<% chip = "flex min-h-14 cursor-pointer items-center justify-center rounded-2xl border border-ink-200 bg-ink-100 px-3 text-center text-base leading-tight text-ink-800 peer-checked:border-accent-400 peer-checked:bg-accent-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-accent-400" %>

<section class="mx-auto w-full max-w-xl py-2 sm:py-6">
  <p class="text-sm text-ink-500"><%= l(@date, format: :long) %></p>
  <h1 class="text-3xl font-semibold tracking-tight"><%= t("daily_check.title") %></h1>
  <p class="mt-1 text-sm text-ink-600"><%= t("daily_check.hint") %></p>

  <%= form_with model: @check, url: daily_check_path(date: @date.iso8601), method: :patch, scope: :daily_check, data: { turbo: false }, class: "mt-6 space-y-7" do |form| %>
    <% { sleep: DailyCheck::SLEEPS, stress: DailyCheck::STRESSES, caffeine: DailyCheck::CAFFEINES }.each do |field, values| %>
      <fieldset data-question="<%= field %>">
        <legend class="mb-2 text-lg font-medium"><%= t("daily_check.#{field}.question") %></legend>
        <div class="grid grid-cols-3 gap-2">
          <% values.each do |value| %>
            <label>
              <%= form.radio_button field, value, class: "peer sr-only" %>
              <span class="<%= chip %>"><%= t("daily_check.#{field}.#{value}") %></span>
            </label>
          <% end %>
        </div>
        <% if field == :caffeine %>
          <label class="mt-4 block">
            <%= form.hidden_field :skipped_meal, value: "0", id: nil %>
            <%= form.check_box :skipped_meal, { class: "peer sr-only" }, "1", nil %>
            <span class="<%= chip %> w-full"><%= t("daily_check.skipped_meal") %></span>
          </label>
        <% end %>
      </fieldset>
    <% end %>

    <%= form.submit t("daily_check.save"), class: "flex min-h-14 w-full cursor-pointer items-center justify-center rounded-2xl bg-accent-600 text-lg font-semibold text-white hover:bg-accent-500" %>
  <% end %>

  <p class="mt-6 text-sm text-ink-500">
    <% if @date == Date.current %>
      <%= link_to t("daily_check.yesterday"), daily_check_path(date: (@date - 1).iso8601), class: "underline" %>
    <% elsif @date == Date.current - 1 %>
      <%= link_to t("daily_check.today"), daily_check_path(date: Date.current.iso8601), class: "underline" %>
    <% end %>
  </p>
  <p class="mt-4 text-xs leading-5 text-ink-500"><%= t("daily_check.premonitory") %></p>
</section>
