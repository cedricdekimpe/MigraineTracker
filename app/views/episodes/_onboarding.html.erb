<%# Get-started card for a new account: three steps, each a link, done ones ticked. Hidden for good by "Hide". %>
<% steps = [
     { key: "medications", path: account_medications_path, done: current_user.onboarding_medications? },
     { key: "install", path: account_profile_path, done: false, install: true },
     ({ key: "reminder", path: account_profile_path, done: current_user.notifications? } if WebPushSender.enabled?)
   ].compact %>
<section class="rounded-2xl border border-accent-300 bg-accent-50 p-4 text-accent-900" data-onboarding data-controller="onboarding">
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-base font-semibold"><%= t("onboarding.title") %></h2>
    <%= button_to t("onboarding.dismiss"), account_onboarding_path, method: :patch, data: { turbo: false }, form: { class: "shrink-0" },
          class: "min-h-11 cursor-pointer px-2 text-sm underline hover:text-fg" %>
  </div>
  <ul class="mt-2 space-y-1 text-sm">
    <% steps.each do |step| %>
      <li <%= tag.attributes(data: { onboarding_target: "install" }) if step[:install] %> data-step="<%= step[:key] %>" data-done="<%= step[:done] %>">
        <%= link_to step[:path], class: "flex min-h-11 items-center gap-2 font-medium underline" do %>
          <span aria-hidden="true" class="w-5 text-center"><%= step[:done] ? "✓" : "→" %></span>
          <span><%= t("onboarding.steps.#{step[:key]}") %></span>
          <% if step[:done] %><span class="sr-only"><%= t("onboarding.done") %></span><% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
