<%# One month of the paper sheet: days 1-31 as columns, four rows. Cells with content open the day. %>
<% days = sheet.days_of(month) %>
<% rows = [:type, :intensity] %>
<% rows << :cycle if current_user.track_cycle? %>
<% rows << :treatment %>

<section class="rounded-2xl border-2 border-dashed <%= sheet_frame_class(month) %> bg-surface p-3" data-month="<%= month.strftime("%Y-%m") %>">
  <header class="mb-2 flex items-baseline justify-between px-1">
    <h2 class="text-lg font-semibold text-fg"><%= l(month, format: :month_year) %></h2>
    <p class="text-xs text-fg-muted"><%= t("sheet.month_summary", pain: sheet.pain_days(month), treatment: sheet.treatment_days(month)) %></p>
  </header>

  <table class="w-full table-fixed border-collapse text-center text-sm">
    <thead>
      <tr>
        <th class="w-24 lg:w-36"></th>
        <% (1..31).each do |number| %>
          <% date = number <= month.end_of_month.day ? month.change(day: number) : nil %>
          <th class="<%= sheet_column_class(number, month) %> px-0 py-1 text-xs font-semibold <%= date.nil? ? 'text-fg-disabled' : 'text-fg-secondary' %> <%= 'opacity-50' if date && sheet_future?(date) %>">
            <% if date && !sheet_future?(date) %>
              <%= link_to number, new_episode_path(date: date.iso8601), title: t("sheet.add_on_day"),
                    class: "block rounded-lg py-0.5 hover:bg-surface #{'ring-2 ring-primary text-sheet-letter' if date == Date.current}" %>
            <% elsif date %>
              <%= number %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <th scope="row" class="py-2 pr-2 text-left text-xs font-semibold leading-tight text-fg"><%= sheet_row_label(row) %></th>
          <% days.each do |day| %>
            <% number = day.date.day %>
            <td class="<%= sheet_column_class(number, month) %> h-10 p-0 align-middle <%= 'opacity-50' if sheet_future?(day.date) %>" data-day="<%= number %>" data-attribute="<%= row %>">
              <% if row == :cycle %>
                <%= period_toggle(day) unless sheet_future?(day.date) %>
              <% elsif day.any? %>
                <%= link_to history_episodes_path(date: day.date.iso8601), class: "flex h-10 items-center justify-center font-semibold text-sheet-letter hover:bg-surface/60", title: l(day.date, format: :long) do %>
                  <%= sheet_cell(day, row) %>
                <% end %>
              <% end %>
            </td>
          <% end %>
          <% ((month.end_of_month.day + 1)..31).each do |number| %>
            <td class="<%= sheet_column_class(number, month) %> h-10 opacity-40" aria-hidden="true"></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
