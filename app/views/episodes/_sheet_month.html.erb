<%# One month of the paper sheet: days 1-31 as columns, four rows. Cells with content open the day. %>
<% days = sheet.days_of(month) %>
<% rows = [:type, :intensity] %>
<% rows << :cycle if current_user.track_cycle? %>
<% rows << :treatment %>

<section class="rounded-2xl border-2 border-dashed <%= sheet_frame_class(month) %> bg-paper p-3" data-month="<%= month.strftime("%Y-%m") %>">
  <header class="mb-2 flex items-baseline justify-between px-1">
    <h2 class="text-lg font-semibold text-ink-900"><%= l(month, format: :month_year) %></h2>
    <p class="text-xs text-ink-500"><%= t("sheet.month_summary", pain: sheet.pain_days(month), treatment: sheet.treatment_days(month)) %></p>
  </header>

  <table class="w-full table-fixed border-collapse text-center text-sm">
    <thead>
      <tr>
        <th class="w-24 lg:w-36"></th>
        <% (1..31).each do |number| %>
          <% date = number <= month.end_of_month.day ? month.change(day: number) : nil %>
          <th class="<%= sheet_column_class(number, month) %> px-0 py-1 text-xs font-semibold <%= date.nil? ? 'text-ink-300' : 'text-ink-700' %>">
            <% if date && !sheet_future?(date) %>
              <%= link_to number, new_episode_path(date: date.iso8601), title: t("sheet.add_on_day"),
                    class: "block rounded py-0.5 hover:bg-paper #{'ring-2 ring-accent-600 text-accent-800' if date == Date.current}" %>
            <% else %>
              <%= number %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <th scope="row" class="py-2 pr-2 text-left text-[0.7rem] font-semibold leading-tight text-ink-800 lg:text-xs"><%= sheet_row_label(row) %></th>
          <% days.each do |day| %>
            <% number = day.date.day %>
            <td class="<%= sheet_column_class(number, month) %> h-10 p-0 align-middle" data-day="<%= number %>" data-attribute="<%= row %>">
              <% if day.any? %>
                <%= link_to history_episodes_path(date: day.date.iso8601), class: "flex h-10 items-center justify-center font-semibold text-accent-700 hover:bg-paper/60", title: l(day.date, format: :long) do %>
                  <%= sheet_cell(day, row) %>
                <% end %>
              <% end %>
            </td>
          <% end %>
          <% ((month.end_of_month.day + 1)..31).each do |number| %>
            <td class="<%= sheet_column_class(number, month) %> h-10 opacity-40" aria-hidden="true"></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
