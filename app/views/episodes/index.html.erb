<% content_for :title, t("sheet.title") %>
<% content_for :wide, true %>

<section class="space-y-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold text-fg sm:text-4xl">
        <span class="md:hidden"><%= l(@month, format: :month_year) %></span>
        <span class="hidden md:inline"><%= sheet_title(@quarter) %></span>
      </h1>
      <p class="mt-1 text-sm text-fg-secondary md:hidden" data-month-summary><%= t("sheet.month_summary", pain: @sheet.pain_days(@month), treatment: @sheet.treatment_days(@month)) %></p>
    </div>

    <%# Phones page through months, larger screens through the paper's quarters %>
    <nav class="flex items-center gap-2 text-sm md:hidden" aria-label="<%= t("sheet.nav.months") %>">
      <%= link_to t("sheet.nav.previous"), episodes_path(month: @previous_month.strftime("%Y-%m")), class: "rounded-xl border border-line bg-surface px-4 py-2 font-medium text-fg-secondary hover:bg-surface-soft" if @previous_month %>
      <%= link_to t("sheet.nav.today"), episodes_path, class: "rounded-xl px-3 py-2 font-medium text-link hover:bg-surface-soft" %>
      <%= link_to t("sheet.nav.next"), episodes_path(month: @next_month.strftime("%Y-%m")), class: "rounded-xl border border-line bg-surface px-4 py-2 font-medium text-fg-secondary hover:bg-surface-soft" if @next_month %>
    </nav>
    <nav class="hidden items-center gap-2 text-sm md:flex" aria-label="<%= t("sheet.nav.quarters") %>">
      <%= link_to t("sheet.nav.previous"), episodes_path(month: @previous_quarter.strftime("%Y-%m")), class: "rounded-xl border border-line bg-surface px-4 py-2 font-medium text-fg-secondary hover:bg-surface-soft" if @previous_quarter %>
      <%= link_to t("sheet.nav.today"), episodes_path, class: "rounded-xl px-3 py-2 font-medium text-link hover:bg-surface-soft" %>
      <%= link_to t("sheet.nav.next"), episodes_path(month: @next_quarter.strftime("%Y-%m")), class: "rounded-xl border border-line bg-surface px-4 py-2 font-medium text-fg-secondary hover:bg-surface-soft" if @next_quarter %>
    </nav>
  </header>

  <%= render "onboarding" if current_user.onboarding? %>

  <% todays_check = current_user.daily_checks.find_by(date: Date.current) %>
  <%= link_to daily_check_path(date: Date.current.iso8601), data: { daily_check_card: todays_check ? "done" : "todo" },
        class: "flex items-center justify-between gap-3 rounded-2xl border px-4 py-3 text-sm #{todays_check ? 'border-line bg-surface text-fg-secondary' : 'border-accent-300 bg-accent-50 text-accent-900'} hover:border-accent-400" do %>
    <span>
      <span class="font-semibold"><%= todays_check ? t("daily_check.card.done") : t("daily_check.card.todo") %></span>
    </span>
    <span class="font-medium underline"><%= todays_check ? t("daily_check.card.edit") : "→" %></span>
  <% end %>

  <%# Phone: the selected month as a vertical list of days %>
  <div class="md:hidden">
    <%= render "day_list", month: @month, sheet: @sheet %>
  </div>

  <%# Larger screens: the paper sheet, three months stacked in yellow / pink / blue %>
  <div class="hidden space-y-5 md:block">
    <% @quarter.each do |month| %>
      <%= render "sheet_month", month: month, sheet: @sheet %>
    <% end %>
  </div>

  <%= render "legend" %>

  <footer class="flex flex-wrap gap-3 text-sm">
    <%= render "episodes/report_link", year: @month.year, button_class: "rounded-xl border border-accent-200 bg-accent-50 px-4 py-2 font-semibold text-accent-800 hover:bg-accent-100" %>
    <%= link_to t("sheet.links.past_episode"), new_episode_path, class: "rounded-xl border border-line bg-surface px-4 py-2 font-medium text-fg-secondary hover:bg-surface-soft" %>
    <%= link_to t("sheet.links.history"), history_episodes_path, class: "rounded-xl border border-line bg-surface px-4 py-2 font-medium text-fg-secondary hover:bg-surface-soft" %>
    <%= link_to t("sheet.links.year"), yearly_episodes_path(year: @month.year), class: "rounded-xl border border-line bg-surface px-4 py-2 font-medium text-fg-secondary hover:bg-surface-soft" %>
  </footer>
</section>
