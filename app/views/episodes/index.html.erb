<% content_for :title, t("sheet.title") %>
<% content_for :wide, true %>

<section class="space-y-6">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm text-ink-500"><%= t("sheet.eyebrow") %></p>
      <h1 class="text-3xl font-semibold text-ink-900 sm:text-4xl">
        <span class="md:hidden"><%= l(@month, format: :month_year) %></span>
        <span class="hidden md:inline"><%= sheet_title(@quarter) %></span>
      </h1>
      <p class="mt-1 text-sm text-ink-600 md:hidden" data-month-summary><%= t("sheet.month_summary", pain: @sheet.pain_days(@month), treatment: @sheet.treatment_days(@month)) %></p>
    </div>

    <%# Phones page through months, larger screens through the paper's quarters %>
    <nav class="flex items-center gap-2 text-sm md:hidden" aria-label="<%= t("sheet.nav.months") %>">
      <%= link_to t("sheet.nav.previous"), episodes_path(month: @previous_month.strftime("%Y-%m")), class: "rounded-xl border border-ink-200 bg-paper px-4 py-2 font-medium text-ink-700 hover:bg-ink-100" %>
      <%= link_to t("sheet.nav.today"), episodes_path, class: "rounded-xl px-3 py-2 font-medium text-accent-700 hover:bg-ink-100" %>
      <%= link_to t("sheet.nav.next"), episodes_path(month: @next_month.strftime("%Y-%m")), class: "rounded-xl border border-ink-200 bg-paper px-4 py-2 font-medium text-ink-700 hover:bg-ink-100" %>
    </nav>
    <nav class="hidden items-center gap-2 text-sm md:flex" aria-label="<%= t("sheet.nav.quarters") %>">
      <%= link_to t("sheet.nav.previous"), episodes_path(month: @previous_quarter.strftime("%Y-%m")), class: "rounded-xl border border-ink-200 bg-paper px-4 py-2 font-medium text-ink-700 hover:bg-ink-100" %>
      <%= link_to t("sheet.nav.today"), episodes_path, class: "rounded-xl px-3 py-2 font-medium text-accent-700 hover:bg-ink-100" %>
      <%= link_to t("sheet.nav.next"), episodes_path(month: @next_quarter.strftime("%Y-%m")), class: "rounded-xl border border-ink-200 bg-paper px-4 py-2 font-medium text-ink-700 hover:bg-ink-100" %>
    </nav>
  </header>

  <%# Phone: the selected month as a vertical list of days %>
  <div class="md:hidden">
    <%= render "day_list", month: @month, sheet: @sheet %>
  </div>

  <%# Larger screens: the paper sheet, three months stacked in yellow / pink / blue %>
  <div class="hidden space-y-5 md:block">
    <% @quarter.each do |month| %>
      <%= render "sheet_month", month: month, sheet: @sheet %>
    <% end %>
  </div>

  <%= render "legend" %>

  <footer class="flex flex-wrap gap-3 text-sm">
    <%= link_to t("sheet.links.report"), yearly_episodes_path(year: @month.year, format: :pdf), data: { turbo: false }, class: "rounded-xl border border-accent-200 bg-accent-50 px-4 py-2 font-semibold text-accent-800 hover:bg-accent-100" %>
    <%= link_to t("sheet.links.past_episode"), new_episode_path, class: "rounded-xl border border-ink-200 bg-paper px-4 py-2 font-medium text-ink-700 hover:bg-ink-100" %>
    <%= link_to t("sheet.links.history"), history_episodes_path, class: "rounded-xl border border-ink-200 bg-paper px-4 py-2 font-medium text-ink-700 hover:bg-ink-100" %>
    <%= link_to t("sheet.links.year"), yearly_episodes_path(year: @month.year), class: "rounded-xl border border-ink-200 bg-paper px-4 py-2 font-medium text-ink-700 hover:bg-ink-100" %>
  </footer>
</section>
