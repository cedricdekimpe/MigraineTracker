<% content_for :title, t('migraines.title') %>

<section class="flex flex-col gap-6">
  <header class="flex flex-col gap-4 rounded-2xl border border-ink-200 bg-paper p-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-medium text-ink-500"><%= t('migraines.current_month') %></p>
      <h1 class="text-2xl font-semibold text-ink-900"><%= l(@current_month, format: :month_year) %></h1>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm">
      <%= link_to t('migraines.previous'), episodes_path(month: @previous_month.strftime("%Y-%m")), class: "rounded-lg border border-ink-300 bg-paper px-3 py-1.5 font-medium text-ink-700 transition hover:border-ink-400" %>
      <%= link_to t('migraines.next'), episodes_path(month: @next_month.strftime("%Y-%m")), class: "rounded-lg border border-ink-300 bg-paper px-3 py-1.5 font-medium text-ink-700 transition hover:border-ink-400" %>
      <%= link_to t('migraines.yearly_view'), yearly_episodes_path(year: @current_month.year), class: "rounded-lg border border-ink-300 bg-paper px-3 py-1.5 font-medium text-ink-700 transition hover:border-ink-400" %>
      <%= link_to t('migraines.new_entry'), new_episode_path, class: "rounded-lg bg-accent-600 px-3 py-1.5 font-semibold text-white transition hover:bg-accent-700" %>
    </div>
  </header>

  <%= render partial: "calendar_table", locals: { month: @current_month, episodes_by_day: @episodes_by_day, days: @days } %>
</section>
