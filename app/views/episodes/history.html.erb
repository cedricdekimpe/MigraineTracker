<% content_for :title, t('migraines.history_title') %>

<section class="mx-auto w-full max-w-4xl">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-fg"><%= t('migraines.history_title') %></h1>
  </header>

  <%# Year Filter %>
  <% if @years.any? %>
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <span class="text-sm font-medium text-fg-secondary"><%= t('migraines.filter_by_year') %>:</span>
      <%= link_to t('migraines.all_years'), history_episodes_path, 
          class: "rounded-lg px-3 py-1.5 text-sm font-medium transition #{@selected_year.nil? ? 'bg-primary text-primary-on' : 'bg-surface-soft text-fg-secondary hover:bg-ink-200'}" %>
      <% @years.each do |year| %>
        <%= link_to year, history_episodes_path(year: year), 
            class: "rounded-lg px-3 py-1.5 text-sm font-medium transition #{@selected_year == year ? 'bg-primary text-primary-on' : 'bg-surface-soft text-fg-secondary hover:bg-ink-200'}" %>
      <% end %>
    </div>
  <% end %>

  <% if @selected_date %>
    <p class="mb-4 text-sm text-fg-secondary">
      <%= l(@selected_date, format: :long) %> ·
      <%= link_to t("migraines.all_years"), history_episodes_path, class: "font-medium text-link hover:text-accent-800" %>
    </p>
  <% end %>

  <% if @episodes.any? %>
    <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
      <% @episodes.each do |episode| %>
        <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="space-y-1">
            <p class="font-medium text-fg">
              <%= l(episode.occurred_on, format: :long) %>
              <% if episode_time_label(episode) %><span class="font-normal text-fg-muted">· <%= episode_time_label(episode) %></span><% end %>
            </p>
            <p class="text-sm text-fg-secondary">
              <%= episode_kind_label(episode) %>
              <% if current_user.track_cycle? && @period_dates.include?(episode.occurred_on) %><span class="ml-2 text-rose-600">· <%= t("episodes.on_period") %></span><% end %>
            </p>
            <%= render "episodes/long_attack_note" if episode.long_attack? %>
            <% if episode.medication_intakes.any? %>
              <p class="text-sm text-fg-secondary">
                <%= episode.medication_intakes.map { |intake| [intake.medication.name, intake.dose].compact_blank.join(" ") }.to_sentence %>
              </p>
            <% end %>
            <% if episode.triggers.any? %>
              <p class="flex flex-wrap gap-1.5 pt-1">
                <% episode.triggers.sort_by(&:display_name).each do |trigger| %>
                  <span class="rounded-full bg-surface-soft px-2.5 py-0.5 text-xs text-fg-secondary"><%= trigger.display_name %></span>
                <% end %>
              </p>
            <% end %>
            <% if episode.notes.present? %>
              <p class="pt-1 text-sm italic text-fg-muted"><%= episode.notes %></p>
            <% end %>
          </div>
          <div class="flex items-center gap-3 sm:flex-col sm:items-end">
            <% if episode.intensity %>
              <span class="text-sm" data-intensity><%= intensity_mark(episode.intensity) %><span class="text-fg-muted">/10</span></span>
            <% end %>
            <div class="flex items-center gap-2">
              <%= link_to t("migraines.edit"), edit_episode_path(episode, year: @selected_year, date: @selected_date&.iso8601), class: "rounded-lg border border-line-control bg-surface px-3 py-1.5 text-sm font-medium text-fg-secondary transition hover:bg-page" %>
              <%= button_to t("migraines.delete"), episode_path(episode, year: @selected_year, date: @selected_date&.iso8601), method: :delete,
                    data: { turbo_confirm: t("migraines.confirm_delete") },
                    class: "rounded-lg border border-rose-300 bg-surface px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50",
                    form: { class: "inline" } %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <%# Pagination %>
    <% if @pagy.pages > 1 %>
      <div class="mt-6">
        <%== pagy_tailwind_nav(@pagy) %>
      </div>
    <% end %>
  <% else %>
    <%# Empty State %>
    <div class="rounded-2xl border border-dashed border-line-control bg-surface px-6 py-12 text-center">
      <svg class="mx-auto h-12 w-12 text-fg-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <h3 class="mt-4 text-lg font-medium text-fg"><%= t('migraines.no_history') %></h3>
      <%= link_to t('migraines.new_entry'), new_episode_path, 
          class: "mt-4 inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover" %>
    </div>
  <% end %>
</section>
