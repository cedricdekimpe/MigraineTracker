<% content_for :title, t('migraines.history_title') %>

<section class="mx-auto w-full max-w-4xl">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-ink-900"><%= t('migraines.history_title') %></h1>
    <p class="mt-2 text-sm text-ink-500"><%= t('migraines.history_description') %></p>
  </header>

  <%# Year Filter %>
  <% if @years.any? %>
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <span class="text-sm font-medium text-ink-700"><%= t('migraines.filter_by_year') %>:</span>
      <%= link_to t('migraines.all_years'), history_episodes_path, 
          class: "rounded-lg px-3 py-1.5 text-sm font-medium transition #{@selected_year.nil? ? 'bg-accent-600 text-white' : 'bg-ink-100 text-ink-700 hover:bg-ink-200'}" %>
      <% @years.each do |year| %>
        <%= link_to year, history_episodes_path(year: year), 
            class: "rounded-lg px-3 py-1.5 text-sm font-medium transition #{@selected_year == year ? 'bg-accent-600 text-white' : 'bg-ink-100 text-ink-700 hover:bg-ink-200'}" %>
      <% end %>
    </div>
  <% end %>

  <% if @selected_date %>
    <p class="mb-4 text-sm text-ink-600">
      <%= l(@selected_date, format: :long) %> ·
      <%= link_to t("migraines.all_years"), history_episodes_path, class: "font-medium text-accent-700 hover:text-accent-800" %>
    </p>
  <% end %>

  <% if @episodes.any? %>
    <ul class="divide-y divide-ink-200 overflow-hidden rounded-2xl border border-ink-200 bg-paper">
      <% @episodes.each do |episode| %>
        <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="space-y-1">
            <p class="font-medium text-ink-900">
              <%= l(episode.occurred_on, format: :long) %>
              <% if episode_time_label(episode) %><span class="font-normal text-ink-500">· <%= episode_time_label(episode) %></span><% end %>
            </p>
            <p class="text-sm text-ink-700">
              <%= episode_kind_label(episode) %>
              <% if episode.on_period? && current_user.track_cycle? %><span class="ml-2 text-rose-600">· <%= t("episodes.on_period") %></span><% end %>
            </p>
            <% if episode.medication_intakes.any? %>
              <p class="text-sm text-ink-600">
                <%= episode.medication_intakes.map { |intake| [intake.medication.name, intake.dose].compact_blank.join(" ") }.to_sentence %>
              </p>
            <% end %>
            <% if episode.triggers.any? %>
              <p class="flex flex-wrap gap-1.5 pt-1">
                <% episode.triggers.sort_by(&:name).each do |trigger| %>
                  <span class="rounded-full bg-ink-100 px-2.5 py-0.5 text-xs text-ink-700"><%= trigger.name %></span>
                <% end %>
              </p>
            <% end %>
            <% if episode.notes.present? %>
              <p class="pt-1 text-sm italic text-ink-500"><%= episode.notes %></p>
            <% end %>
          </div>
          <div class="flex items-center gap-3 sm:flex-col sm:items-end">
            <% if episode.intensity %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= intensity_badge_class(episode.intensity) %>"><%= episode.intensity %>/10</span>
            <% end %>
            <div class="flex items-center gap-2">
              <%= link_to t("migraines.edit"), edit_episode_path(episode, year: @selected_year, date: @selected_date&.iso8601), class: "rounded-lg border border-ink-300 bg-paper px-3 py-1.5 text-sm font-medium text-ink-700 transition hover:bg-ink-50" %>
              <%= button_to t("migraines.delete"), episode_path(episode, year: @selected_year, date: @selected_date&.iso8601), method: :delete,
                    data: { turbo_confirm: t("migraines.confirm_delete") },
                    class: "rounded-lg border border-rose-300 bg-paper px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50",
                    form: { class: "inline" } %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <%# Pagination %>
    <% if @pagy.pages > 1 %>
      <div class="mt-6">
        <%== pagy_tailwind_nav(@pagy) %>
      </div>
    <% end %>
  <% else %>
    <%# Empty State %>
    <div class="rounded-2xl border border-dashed border-ink-300 bg-paper px-6 py-12 text-center">
      <svg class="mx-auto h-12 w-12 text-ink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <h3 class="mt-4 text-lg font-medium text-ink-900"><%= t('migraines.no_history') %></h3>
      <p class="mt-2 text-sm text-ink-500"><%= t('migraines.no_history_hint') %></p>
      <%= link_to t('migraines.new_entry'), new_episode_path, 
          class: "mt-4 inline-flex items-center rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-700" %>
    </div>
  <% end %>
</section>
