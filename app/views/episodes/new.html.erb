<% content_for :title, t("episodes.log_title") %>

<section class="mx-auto w-full max-w-2xl rounded-2xl border border-ink-200 bg-paper p-8">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-ink-900"><%= t("episodes.log_title") %></h1>
    <p class="mt-2 text-sm text-ink-500"><%= t("episodes.log_description") %></p>
  </header>

  <%= render "form", episode: @episode, medications: @medications, triggers: @triggers, suggested_medications: @suggested_medications,
        cancel_path: episodes_path, submit_label: t("episodes.save") %>
</section>
