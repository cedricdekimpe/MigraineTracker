<% content_for :title, t("episodes.log_title") %>

<section class="mx-auto w-full max-w-2xl rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900"><%= t("episodes.log_title") %></h1>
    <p class="mt-2 text-sm text-slate-500"><%= t("episodes.log_description") %></p>
  </header>

  <%= render "form", episode: @episode, medications: @medications, triggers: @triggers, suggested_medications: @suggested_medications,
        cancel_path: episodes_path, submit_label: t("episodes.save") %>
</section>
