<% content_for :title, t('migraines.yearly_title') %>
<% content_for :wide, true %>

<section class="flex flex-col gap-6">
  <header class="flex flex-col gap-4 rounded-2xl border border-ink-200 bg-paper p-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-medium text-ink-500"><%= t('migraines.year_label') %></p>
      <h1 class="text-2xl font-semibold text-ink-900"><%= @current_year %></h1>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm">
      <%= link_to t('migraines.previous'), yearly_episodes_path(year: @previous_year), class: "rounded-lg border border-ink-300 bg-paper px-3 py-1.5 font-medium text-ink-700 transition hover:border-ink-400" %>
      <%= link_to t('migraines.next'), yearly_episodes_path(year: @next_year), class: "rounded-lg border border-ink-300 bg-paper px-3 py-1.5 font-medium text-ink-700 transition hover:border-ink-400" %>
      <%= link_to t('migraines.export_pdf'), yearly_episodes_path(year: @current_year, format: :pdf), data: { turbo: false }, class: "rounded-lg border border-accent-200 bg-accent-50 px-3 py-1.5 font-semibold text-accent-700 transition hover:bg-accent-100" %>
      <%= link_to t('navigation.migraine_log'), episodes_path(month: Date.new(@current_year, Date.current.month, 1).strftime("%Y-%m")), class: "rounded-lg border border-ink-300 bg-paper px-3 py-1.5 font-medium text-ink-700 transition hover:border-ink-400" %>
      <%= link_to t('migraines.new_entry'), new_episode_path, class: "rounded-lg bg-accent-600 px-3 py-1.5 font-semibold text-white transition hover:bg-accent-700" %>
    </div>
  </header>

  <div class="space-y-6">
    <% @months.each do |month| %>
      <div class="overflow-x-auto">
        <div class="min-w-[44rem]"><%= render "sheet_month", month: month, sheet: @sheet %></div>
      </div>
    <% end %>
  </div>

  <%= render "legend" %>
</section>
