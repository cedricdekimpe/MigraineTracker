<%# Shared by new and edit. Pain, intensity, medication and triggers are one-tap chips; the rest is optional. %>
<%
  chip = "inline-flex cursor-pointer items-center rounded-full border border-ink-300 bg-paper px-4 py-2 text-sm font-medium text-ink-700 transition hover:border-accent-400 peer-checked:border-accent-600 peer-checked:bg-accent-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-accent-500"
  input_class = "block w-full rounded-lg border border-ink-300 px-3 py-2 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500"
  selected_medication_ids = episode.medication_intakes.reject(&:marked_for_destruction?).map(&:medication_id)
  selected_trigger_ids = episode.trigger_ids
%>

<%= render "shared/form_errors", object: episode %>

<%= form_with model: episode, class: "mt-6 space-y-8" do |form| %>
  <%= hidden_field_tag :year, params[:year] if params[:year].present? %>
  <%= hidden_field_tag :date, params[:date] if params[:date].present? %>

  <div class="space-y-2">
    <%= form.label :occurred_on, t("episodes.date"), class: "block text-sm font-medium text-ink-700" %>
    <%= form.date_field :occurred_on, class: input_class %>
  </div>

  <fieldset class="space-y-3">
    <legend class="text-sm font-medium text-ink-700"><%= t("episodes.pain") %></legend>
    <div class="flex flex-wrap gap-2">
      <% [["", t("episodes.pain_none")], ["migraine", t("episodes.pain_migraine")], ["headache", t("episodes.pain_headache")]].each do |value, label| %>
        <label>
          <%= form.radio_button :pain_kind, value, checked: episode.pain_kind.to_s == value, class: "peer sr-only" %>
          <span class="<%= chip %>"><%= label %></span>
        </label>
      <% end %>
    </div>
    <div>
      <label>
        <%= form.check_box :aura, class: "peer sr-only" %>
        <span class="<%= chip %>"><%= t("episodes.aura") %></span>
      </label>
      <p class="mt-1 text-xs text-ink-500"><%= t("episodes.aura_hint") %></p>
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="text-sm font-medium text-ink-700"><%= t("episodes.intensity") %> <span class="font-normal text-ink-500">(1–10)</span></legend>
    <div class="flex flex-wrap gap-2">
      <% (1..10).each do |value| %>
        <label>
          <%= form.radio_button :intensity, value, class: "peer sr-only" %>
          <span class="<%= chip %> min-w-11 justify-center"><%= value %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="flex w-full items-center justify-between text-sm font-medium text-ink-700">
      <%= t("episodes.medication") %>
      <%= link_to t("episodes.manage_medications"), account_medications_path, class: "text-xs font-medium text-accent-700 hover:text-accent-800" %>
    </legend>
    <div class="flex flex-wrap gap-2">
      <% medications.each do |medication| %>
        <label>
          <%= check_box_tag "episode[medication_ids][]", medication.id, selected_medication_ids.include?(medication.id), id: "episode_medication_#{medication.id}", class: "peer sr-only" %>
          <span class="<%= chip %>"><%= medication.name %></span>
        </label>
      <% end %>
      <% if medications.empty? %>
        <p class="text-sm text-ink-500"><%= t("episodes.no_medication_yet") %></p>
      <% end %>
    </div>
    <% if suggested_medications.any? %>
      <div class="space-y-2">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-500"><%= t("episodes.common_medications") %></p>
        <div class="flex flex-wrap gap-2">
          <% suggested_medications.each_with_index do |name, index| %>
            <label>
              <%= check_box_tag "episode[suggested_medications][]", name, false, id: "episode_suggested_medication_#{index}", class: "peer sr-only" %>
              <span class="<%= chip %> border-dashed"><%= name %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>
    <div>
      <div class="flex flex-col gap-2 sm:flex-row">
        <%= text_field_tag "episode[new_medication_names]", params.dig(:episode, :new_medication_names), placeholder: t("episodes.add_medication"), "aria-label": t("episodes.add_medication"), class: "#{input_class} sm:flex-1" %>
        <%= select_tag "episode[new_medication_kind]", options_for_select(%w[acute combination triptan gepant other].map { |kind| [t("medications_page.kinds.#{kind}"), kind] }, params.dig(:episode, :new_medication_kind)), "aria-label": t("medications_page.kind"), class: "#{input_class} sm:w-72" %>
      </div>
      <p class="mt-1 text-xs text-ink-500"><%= t("episodes.add_medication_hint") %></p>
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="flex w-full items-center justify-between text-sm font-medium text-ink-700">
      <%= t("episodes.triggers") %>
      <%= link_to t("episodes.manage_triggers"), account_triggers_path, class: "text-xs font-medium text-accent-700 hover:text-accent-800" %>
    </legend>
    <div class="flex flex-wrap gap-2">
      <% triggers.each do |trigger| %>
        <label>
          <%= check_box_tag "episode[trigger_ids][]", trigger.id, selected_trigger_ids.include?(trigger.id), id: "episode_trigger_#{trigger.id}", class: "peer sr-only" %>
          <span class="<%= chip %>"><%= trigger.name %></span>
        </label>
      <% end %>
    </div>
    <div>
      <%= text_field_tag "episode[new_trigger_names]", params.dig(:episode, :new_trigger_names), placeholder: t("episodes.add_trigger"), "aria-label": t("episodes.add_trigger"), class: input_class %>
      <p class="mt-1 text-xs text-ink-500"><%= t("episodes.add_trigger_hint") %></p>
    </div>
  </fieldset>

  <details class="rounded-xl border border-ink-200 p-4" <%= "open" if episode.persisted? || episode.errors.any? %>>
    <summary class="cursor-pointer text-sm font-medium text-ink-700"><%= t("episodes.more_details") %></summary>
    <div class="mt-4 space-y-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
          <%= form.label :started_time, t("episodes.start_time"), class: "block text-sm font-medium text-ink-700" %>
          <%= form.time_field :started_time, value: episode.started_time&.strftime("%H:%M"), class: input_class %>
        </div>
        <div class="space-y-2">
          <%= form.label :duration_minutes, t("episodes.duration"), class: "block text-sm font-medium text-ink-700" %>
          <%= form.number_field :duration_minutes, min: 1, step: 1, class: input_class %>
        </div>
      </div>

      <% if current_user.track_cycle? %>
        <div class="flex items-center gap-3">
          <%= form.check_box :on_period, class: "h-4 w-4 rounded border-ink-300 text-accent-600 focus:ring-accent-500" %>
          <%= form.label :on_period, t("episodes.on_period"), class: "text-sm font-medium text-ink-700" %>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= form.label :notes, t("episodes.notes"), class: "block text-sm font-medium text-ink-700" %>
        <%= form.text_area :notes, rows: 3, class: input_class %>
      </div>

      <% if form.object.medication_intakes.reject(&:new_record?).any? %>
        <div class="space-y-3">
          <h3 class="text-sm font-medium text-ink-700"><%= t("episodes.intake_details") %></h3>
          <%= form.fields_for :medication_intakes, form.object.medication_intakes.reject(&:new_record?) do |intake_form| %>
            <div class="grid gap-3 rounded-lg border border-ink-200 p-3 sm:grid-cols-4 sm:items-end">
              <p class="text-sm font-medium text-ink-900 sm:self-center"><%= intake_form.object.medication.name %></p>
              <div>
                <%= intake_form.label :dose, t("episodes.dose"), class: "block text-xs font-medium text-ink-600" %>
                <%= intake_form.text_field :dose, class: input_class %>
              </div>
              <div>
                <%= intake_form.label :taken_time, t("episodes.taken_at"), class: "block text-xs font-medium text-ink-600" %>
                <%= intake_form.time_field :taken_time, value: intake_form.object.taken_time&.strftime("%H:%M"), class: input_class %>
              </div>
              <div>
                <%= intake_form.label :effect, t("episodes.effect"), class: "block text-xs font-medium text-ink-600" %>
                <%= intake_form.select :effect, MedicationIntake::EFFECTS.map { |effect| [t("episodes.effects.#{effect}"), effect] }, { include_blank: "—" }, class: input_class %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>

  <div class="flex items-center justify-between border-t border-ink-200 pt-6">
    <%= link_to t("episodes.cancel"), cancel_path, class: "rounded-lg border border-transparent px-3 py-2 text-sm font-medium text-ink-600 transition hover:text-ink-800" %>
    <%= form.submit submit_label, class: "cursor-pointer rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-700" %>
  </div>
<% end %>
