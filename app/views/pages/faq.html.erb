<% content_for :title, t('faq.title') %>
<% content_for :description, t('faq.subtitle') %>

<%
  # Questions by section, with the page each answer points to when there is one
  sections = {
    usage: %w[track_crisis guest daily_check medications statistics report],
    account: %w[export import delete],
    privacy: %w[storage sharing rights]
  }
  links = {
    "statistics" => [:numbers, numbers_path], "export" => [:data, account_data_path], "import" => [:data, account_data_path],
    "delete" => [:data, account_data_path], "storage" => [:privacy, privacy_path], "sharing" => [:privacy, privacy_path],
    "rights" => [:privacy, privacy_path]
  }
  faq_items = sections.values.flatten.map { |key| { question: t("faq.items.#{key}.question"), answer: t("faq.items.#{key}.answer") } }
%>

<div class="mx-auto max-w-3xl space-y-6" data-faq>
  <header>
    <h1 class="text-3xl font-bold text-fg"><%= t('faq.title') %></h1>
    <p class="mt-2 text-fg-secondary"><%= t('faq.subtitle') %></p>
  </header>

  <% sections.each do |section, keys| %>
    <section class="rounded-2xl border border-line bg-surface p-5 sm:p-6" data-faq-section="<%= section %>">
      <h2 class="mb-4 text-xl font-semibold text-fg"><%= t("faq.sections.#{section}") %></h2>
      <div class="space-y-3">
        <% keys.each do |key| %>
          <details class="group rounded-xl border border-line bg-page" id="<%= key.dasherize %>">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-medium text-fg [&::-webkit-details-marker]:hidden">
              <%= t("faq.items.#{key}.question") %>
              <span class="text-fg-muted transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="space-y-2 px-4 pb-4 text-sm leading-6 text-fg-secondary">
              <p><%= t("faq.items.#{key}.answer") %></p>
              <% if (link = links[key]) %>
                <p><%= link_to t("faq.links.#{link.first}"), link.last, class: "font-medium text-link underline" %></p>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="rounded-2xl border border-line bg-surface p-5 text-sm text-fg-secondary sm:p-6">
    <h2 class="text-base font-semibold text-fg"><%= t('faq.disclaimer_title') %></h2>
    <p class="mt-1"><%= t('faq.disclaimer_text') %></p>
    <p class="mt-2"><%= link_to t('faq.links.urgent'), urgent_path, class: "font-medium text-link underline" %></p>
  </section>

  <section class="rounded-2xl border border-line bg-surface p-5 text-sm text-fg-secondary sm:p-6">
    <h2 class="text-base font-semibold text-fg"><%= t('faq.contact_title') %></h2>
    <p class="mt-1"><%= t('faq.contact_text') %> <%= link_to t('faq.links.privacy'), privacy_path(anchor: "contact"), class: "font-medium text-link underline" %></p>
  </section>
</div>

<%# FAQPage structured data, built from the same questions %>
<script type="application/ld+json">
  <%= json_escape(structured_data_faqpage(faq_items).to_json).html_safe %>
</script>
