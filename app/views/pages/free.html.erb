<% content_for :title, t('free.title') %>
<% content_for :description, t('free.description') %>

<article class="mx-auto max-w-3xl space-y-8 rounded-2xl border border-line bg-surface p-5 sm:p-8" data-free>
  <header>
    <h1 class="text-3xl font-bold text-fg"><%= t('free.title') %></h1>
    <p class="mt-1 text-sm text-fg-muted"><%= t('free.updated') %></p>
    <p class="mt-4 text-fg-secondary"><%= t('free.intro') %></p>
  </header>

  <% t('free.sections').each do |key, section| %>
    <section id="<%= key %>" class="scroll-mt-20">
      <h2 class="text-xl font-semibold text-fg"><%= section[:title] %></h2>
      <% section[:body].each do |paragraph| %>
        <p class="mt-3 leading-7 text-fg-secondary"><%= paragraph %></p>
      <% end %>

      <%# What it costs: plain figures, dated, in the language of the page %>
      <% if key == :costs %>
        <dl class="mt-4 divide-y divide-line rounded-xl border border-line text-sm" data-costs>
          <% t('free.costs').each do |row| %>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3 <%= 'font-semibold text-fg' if row[:total] %>">
              <dt class="<%= row[:total] ? '' : 'text-fg-secondary' %>"><%= row[:label] %></dt>
              <dd class="tabular-nums"><%= row[:value] %></dd>
            </div>
          <% end %>
        </dl>
        <p class="mt-3 text-sm leading-6 text-fg-muted"><%= t('free.costs_note') %></p>
      <% end %>
    </section>
  <% end %>

  <p class="text-sm text-fg-secondary">
    <%= t('free.contact') %>
    <%= link_to t('privacy.contact_email'), "mailto:#{t('privacy.contact_email')}", class: "font-medium text-link underline" %>
    · <%= link_to t('navigation.about_ai'), about_ai_path, class: "font-medium text-link underline" %>
    · <%= link_to t('navigation.privacy'), privacy_path, class: "font-medium text-link underline" %>
  </p>
</article>
