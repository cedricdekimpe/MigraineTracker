<% content_for :title, t('privacy.title') %>
<% content_for :description, t('privacy.description') %>

<article class="mx-auto max-w-3xl space-y-8 rounded-2xl border border-line bg-surface p-5 sm:p-8" data-privacy>
  <header>
    <h1 class="text-3xl font-bold text-fg"><%= t('privacy.title') %></h1>
    <p class="mt-1 text-sm text-fg-muted"><%= t('privacy.updated') %></p>
    <p class="mt-4 text-fg-secondary"><%= t('privacy.intro') %></p>
  </header>

  <% t('privacy.sections').each do |key, section| %>
    <section id="<%= key %>" class="scroll-mt-20">
      <h2 class="text-xl font-semibold text-fg"><%= section[:title] %></h2>
      <ul class="mt-3 space-y-2 text-sm leading-6 text-fg-secondary">
        <% section[:points].each do |point| %>
          <li class="flex gap-2"><span class="text-link" aria-hidden="true">•</span><span><%= point %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section id="contact" class="scroll-mt-20">
    <h2 class="text-xl font-semibold text-fg"><%= t('privacy.contact_title') %></h2>
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm text-fg-secondary">
      <dt class="font-semibold text-fg"><%= t('privacy.contact_address_label') %></dt><dd><%= t('privacy.contact_address') %></dd>
      <dt class="font-semibold text-fg"><%= t('privacy.contact_email_label') %></dt><dd><%= t('privacy.contact_email') %></dd>
    </dl>
  </section>

</article>
