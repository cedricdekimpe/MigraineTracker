<% content_for :title, t("urgent.title") %>
<% content_for :description, t("urgent.intro") %>

<article class="mx-auto max-w-3xl space-y-8" data-urgent>
  <header>
    <h1 class="text-3xl font-bold text-ink-900"><%= t("urgent.title") %></h1>
    <p class="mt-2 text-sm text-ink-600"><%= t("urgent.intro") %></p>
  </header>

  <section class="rounded-3xl border-2 border-red-300 bg-red-50 p-6" data-urgency="emergency">
    <h2 class="text-xl font-semibold text-red-900"><%= t("urgent.emergency_title") %></h2>
    <ul class="mt-3 space-y-2 text-sm text-red-900">
      <% t("urgent.emergency").each do |point| %>
        <li class="flex gap-2"><span aria-hidden="true">•</span><span><%= point %></span></li>
      <% end %>
    </ul>
  </section>

  <section class="rounded-3xl border border-amber-300 bg-amber-50 p-6" data-urgency="soon">
    <h2 class="text-xl font-semibold text-amber-900"><%= t("urgent.soon_title") %></h2>
    <ul class="mt-3 space-y-2 text-sm text-amber-900">
      <% t("urgent.soon").each do |point| %>
        <li class="flex gap-2"><span aria-hidden="true">•</span><span><%= point %></span></li>
      <% end %>
    </ul>
  </section>

  <p class="text-xs leading-5 text-ink-500"><%= t("urgent.source") %></p>
</article>
