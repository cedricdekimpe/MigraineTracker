<% content_for :title, "Create account" %>

<section class="mx-auto w-full max-w-md">
  <div class="rounded-2xl border border-line bg-surface p-8">
    <h1 class="text-2xl font-semibold text-fg">Create your account</h1>
    <p class="mt-2 text-sm text-fg-muted">Join Migraine Tracker to log episodes, triggers, and treatments.</p>

    <div class="mt-6">
      <%= render "devise/shared/error_messages" %>
    </div>

    <%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), data: { turbo: false }, html: { class: "mt-6 space-y-5" } do |form| %>
      <div class="space-y-2">
        <%= form.label :email, class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <%= form.label :password, class: "block text-sm font-medium text-fg-secondary" %>
          <% if @minimum_password_length.present? %>
            <span class="text-xs text-fg-muted"><%= @minimum_password_length %> characters minimum</span>
          <% end %>
        </div>
        <%= form.password_field :password, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password_confirmation, class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="flex items-start gap-3 text-sm text-fg-secondary">
        <%= form.check_box :health_data_consent, { required: true, class: "mt-1 h-6 w-6 rounded border-line-control focus:ring-focus" }, "1", "0" %>
        <label for="user_health_data_consent" class="block">
          <%= t('forms.health_consent_html', privacy: link_to(t('navigation.privacy'), privacy_path, class: "font-semibold text-link hover:text-link")).html_safe %>
        </label>
      </div>

      <%= form.submit "Create account", class: "w-full rounded-lg bg-primary px-4 py-2 text-base font-semibold text-primary-on transition hover:bg-primary-hover" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-fg-secondary">
      <span>Already registered?</span>
      <%= link_to "Sign in", new_session_path(resource_name), class: "font-medium text-link hover:text-accent-800" %>
    </div>
  </div>
</section>
