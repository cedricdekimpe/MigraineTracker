<% content_for :title, t('account.edit_title') %>

<section class="mx-auto flex w-full max-w-4xl flex-col gap-8 lg:flex-row">
  <div class="flex-1 rounded-2xl border border-line bg-surface p-8">
    <header class="mb-6">
      <h1 class="text-2xl font-semibold text-fg"><%= t('account.account_info') %></h1>
    </header>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), method: :put, data: { turbo: false }, class: "space-y-6" do |form| %>
      <div class="space-y-2">
        <%= form.label :email, t('account.email'), class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <%= form.label :password, t('account.password'), class: "block text-sm font-medium text-fg-secondary" %>
          <span class="text-xs text-fg-muted"><%= t('account.password_hint') %></span>
        </div>
        <%= form.password_field :password, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password_confirmation, t('account.password_confirmation'), class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="space-y-2">
        <%= form.label :current_password, t('account.current_password'), class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.password_field :current_password, autocomplete: "current-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
        <p class="text-xs text-fg-muted"><%= t('account.current_password_hint') %></p>
      </div>

      <div class="flex items-center justify-between">
        <%= link_to t('common.back'), root_path, class: "rounded-lg border border-transparent px-3 py-2 text-sm font-medium text-fg-secondary transition hover:text-fg" %>
        <%= form.submit t('account.update_account'), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover" %>
      </div>
    <% end %>
  </div>

  <div class="flex-1 rounded-2xl border border-line bg-surface p-8">
    <header class="mb-6">
      <h2 class="text-xl font-semibold text-fg"><%= t('account.medications_title') %></h2>
      <p class="mt-2 text-sm text-fg-muted"><%= t('account.medications_description') %></p>
    </header>

    <div class="space-y-4">
      <% if current_user.medications.exists? %>
        <ul class="space-y-3">
          <% current_user.medications.order(:name).each do |medication| %>
            <li class="flex items-center justify-between rounded-xl border border-line px-4 py-3">
              <div>
                <p class="text-sm font-medium text-fg"><%= medication.name %></p>
              </div>
              <%= button_to t('common.delete'), medication_path(medication), method: :delete, data: { turbo_confirm: "#{t('common.delete')} #{medication.name}?" }, class: "rounded-lg border border-line-control bg-surface px-3 py-1.5 text-sm font-medium text-fg-secondary transition hover:border-rose-300 hover:text-rose-600" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="rounded-lg border border-dashed border-line-control px-4 py-6 text-center text-sm text-fg-muted"><%= t('account.no_medications') %></p>
      <% end %>

      <div class="border-t border-line pt-4">
        <%= form_with model: Medication.new, url: medications_path, data: { turbo: false }, class: "flex flex-col gap-3 sm:flex-row" do |form| %>
          <%= form.label :name, t('account.medication_name'), class: "sr-only" %>
          <%= form.text_field :name, placeholder: t('account.medication_name'), class: "flex-1 rounded-lg border border-line-control px-3 py-2 text-sm text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
          <%= form.submit t('account.add'), class: "rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto mt-8 w-full max-w-4xl rounded-2xl border border-line bg-surface p-8">
  <header class="mb-6">
    <h2 class="text-xl font-semibold text-fg"><%= t('account.data_management_title') %></h2>
  </header>

  <div class="grid gap-6 md:grid-cols-2">
    <!-- Export Section -->
    <div class="rounded-xl border border-line bg-page p-6">
      <div class="mb-4 flex items-center gap-3">
        <div class="rounded-full bg-accent-100 p-2">
          <svg class="h-5 w-5 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-fg"><%= t('account.export_title') %></h3>
      </div>
      <p class="mb-4 text-sm text-fg-secondary"><%= t('account.export_description') %></p>
      <%= button_to t('account.export_button'), exports_path, 
            method: :post,
            data: { turbo: false },
            class: "w-full rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-on transition hover:bg-primary-hover" %>
    </div>

    <!-- Import Section -->
    <div class="rounded-xl border border-line bg-page p-6">
      <div class="mb-4 flex items-center gap-3">
        <div class="rounded-full bg-accent-100 p-2">
          <svg class="h-5 w-5 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-fg"><%= t('account.import_title') %></h3>
      </div>
      <p class="mb-4 text-sm text-fg-secondary"><%= t('account.import_description') %></p>
      <%= link_to t('account.import_button'), new_import_path, 
            class: "block w-full rounded-lg border border-accent-600 bg-surface px-4 py-2 text-center text-sm font-semibold text-link transition hover:bg-accent-50" %>
    </div>
  </div>
</section>

<%# Danger Zone - Account Deletion %>
<section class="mx-auto mt-8 w-full max-w-4xl" data-controller="account-deletion" data-account-deletion-confirmation-phrase-value="<%= t('account.delete_confirmation_phrase') %>">
  <%# One tinted card: the warning and the button directly in it %>
  <div class="rounded-2xl border border-red-300 bg-over-surface p-5 sm:p-8">
    <h2 class="text-xl font-semibold text-over-text"><%= t('account.danger_zone_title') %></h2>
    <h3 class="mt-4 font-medium text-over-text"><%= t('account.delete_account_title') %></h3>
    <p class="mt-1 text-sm text-over-text"><%= t('account.delete_account_warning') %></p>
    <p class="mt-2 text-sm text-over-text">
      <%= t('account.data_to_delete') %>
      <strong><%= t('account.migraines_count', count: current_user.episodes.count) %></strong>,
      <strong><%= t('account.medications_count', count: current_user.medications.count) %></strong>,
      <%= t('account.rest_of_journal') %>
    </p>
    <button type="button" data-action="click->account-deletion#open"
            class="mt-4 min-h-11 w-full cursor-pointer rounded-lg border border-red-400 bg-surface px-4 py-2 text-sm font-semibold text-over-text transition hover:bg-surface-soft sm:w-auto">
      <%= t('account.delete_my_account') %>
    </button>
  </div>

  <%# Account Deletion Modal %>
  <div data-account-deletion-target="modal" 
       data-action="click->account-deletion#closeBackground keydown.esc@window->account-deletion#close"
       class="hidden fixed inset-0 z-50 flex items-center justify-center bg-ink-900/50 p-4">
    <div class="w-full max-w-md rounded-2xl border border-line bg-surface p-6"
         data-action="click->account-deletion#stopPropagation">
      <div class="mb-6">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100">
          <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </div>
        <h3 class="text-center text-lg font-semibold text-fg"><%= t('account.delete_modal_title') %></h3>
        <p class="mt-2 text-center text-sm text-fg-secondary"><%= t('account.delete_modal_description') %></p>
      </div>

      <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4">
        <p class="text-sm text-red-800">
          <strong><%= t('account.delete_modal_warning') %></strong>
        </p>
        <ul class="mt-2 list-inside list-disc text-sm text-red-700">
          <li><%= t('account.migraines_count', count: current_user.episodes.count) %></li>
          <li><%= t('account.medications_count', count: current_user.medications.count) %></li>
          <li><%= t('account.rest_of_journal') %></li>
          <li><%= t('account.delete_modal_account_info') %></li>
        </ul>
      </div>

      <%= form_with url: registration_path(resource_name), method: :delete, data: { turbo: false }, class: "space-y-4" do |form| %>
        <div>
          <label class="block text-sm font-medium text-fg-secondary">
            <%= t('account.delete_modal_type_phrase') %>
            <code class="ml-1 rounded bg-surface-soft px-2 py-0.5 text-sm font-bold text-red-600"><%= t('account.delete_confirmation_phrase') %></code>
          </label>
          <input type="text" 
                 data-account-deletion-target="confirmationInput"
                 data-action="input->account-deletion#validateConfirmation"
                 autocomplete="off"
                 class="mt-2 block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500">
        </div>

        <div>
          <label class="block text-sm font-medium text-fg-secondary"><%= t('account.delete_modal_password') %></label>
          <input type="password" 
                 name="password"
                 data-account-deletion-target="passwordInput"
                 data-action="input->account-deletion#validateConfirmation"
                 autocomplete="current-password"
                 class="mt-2 block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500">
        </div>

        <div class="flex gap-3 pt-2">
          <button type="button" 
                  data-action="click->account-deletion#close"
                  class="flex-1 rounded-lg border border-line-control bg-surface px-4 py-2 text-sm font-medium text-fg-secondary transition hover:bg-page">
            <%= t('common.cancel') %>
          </button>
          <button type="submit" 
                  disabled
                  data-account-deletion-target="submitButton"
                  class="flex-1 rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white opacity-50 cursor-not-allowed transition">
            <%= t('account.delete_account_permanently') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</section>
