<% content_for :title, t("auth.sign_in") %>

<section class="mx-auto w-full max-w-md">
  <div class="rounded-2xl border border-line bg-surface p-8">
    <h1 class="text-2xl font-semibold text-fg"><%= t("auth.welcome_back") %></h1>
    <p class="mt-2 text-sm text-fg-muted"><%= t("auth.sign_in_intro") %></p>

    <div class="mt-6">
      <%= render "devise/shared/error_messages" %>
    </div>

    <%= form_with scope: resource_name, url: session_path(resource_name), data: { turbo: false }, html: { class: "mt-6 space-y-5" } do |form| %>
      <div class="space-y-2">
        <%= form.label :email, t("auth.email"), class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password, t("auth.password"), class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.password_field :password, autocomplete: "current-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center gap-2 text-fg-secondary">
            <%# Ticked by default: the journal is meant to live on a personal phone %>
            <%= form.check_box :remember_me, { checked: true, class: "h-6 w-6 rounded border-line-control text-link focus:ring-focus" } %>
            <span><%= t("sessions.remember_me") %></span>
          </label>
          <% if devise_mapping.recoverable? %>
            <%= link_to t("sessions.forgot_password"), new_password_path(resource_name), class: "font-medium text-link hover:text-accent-800" %>
          <% end %>
        </div>
      <% elsif devise_mapping.recoverable? %>
        <div class="text-right text-sm">
          <%= link_to t("sessions.forgot_password"), new_password_path(resource_name), class: "font-medium text-link hover:text-accent-800" %>
        </div>
      <% end %>

      <%= form.submit t("auth.sign_in"), class: "w-full rounded-lg bg-primary px-4 py-2 text-base font-semibold text-primary-on transition hover:bg-primary-hover" %>
    <% end %>

    <div class="mt-6 text-center text-sm text-fg-secondary">
      <span><%= t("auth.need_account") %></span>
      <%= link_to t("auth.create_one"), new_registration_path(resource_name), class: "font-medium text-link hover:text-accent-800" %>
    </div>
  </div>
</section>
