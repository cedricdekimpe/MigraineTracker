<% content_for :title, t("auth.reset_title") %>

<section class="mx-auto w-full max-w-md">
  <div class="rounded-2xl border border-line bg-surface p-8">
    <h1 class="text-2xl font-semibold text-fg"><%= t("auth.reset_title") %></h1>

    <div class="mt-6">
      <%= render "devise/shared/error_messages" %>
    </div>

    <%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, data: { turbo: false }, html: { class: "mt-6 space-y-5" } do |form| %>
      <%= form.hidden_field :reset_password_token, value: params[:reset_password_token] %>

      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <%= form.label :password, t("auth.new_password"), class: "block text-sm font-medium text-fg-secondary" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-fg-muted"><%= t("auth.min_characters", count: @minimum_password_length) %></span>
          <% end %>
        </div>
        <%= form.password_field :password, autofocus: true, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password_confirmation, t("auth.password_confirmation"), class: "block text-sm font-medium text-fg-secondary" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-line-control px-3 py-2 text-fg focus:border-focus focus:outline-none focus:ring-2 focus:ring-focus" %>
      </div>

      <%= form.submit t("auth.reset_submit"), class: "w-full cursor-pointer rounded-lg bg-primary px-4 py-2 text-base font-semibold text-primary-on transition hover:bg-primary-hover" %>
    <% end %>
  </div>
</section>
