<%# What the neurologist asks about: does each treatment work, how early is it taken, did the preventive help %>
<% acute_rows = insights.acute_rows %>
<% preventive_rows = insights.preventive_rows %>
<% delay = insights.median_delay %>
<% link = current_user.track_cycle? ? insights.menstrual_link : nil %>

<% if chronic_streak.positive? %>
  <section data-chronic>
    <p class="rounded-xl px-4 py-3 text-sm font-medium <%= chronic_streak >= 3 ? 'bg-sustained-surface text-sustained-text' : 'bg-over-surface text-over-text' %>" role="status">
      <%= chronic_streak >= 3 ? t("stats.treatments.chronic_sustained") : t("stats.treatments.chronic_month") %>
    </p>
  </section>
<% end %>

<% if (nausea = insights.nausea) %>
  <p class="text-sm text-fg" data-nausea-summary>
    <%= t("stats.treatments.nausea", with: nausea.with_nausea, rated: nausea.rated, vomiting: nausea.vomiting) %>
    <%= render "shared/info", text: t("stats.treatments.nausea_hint"), more: numbers_path(anchor: "nausea") %>
  </p>
<% end %>

<% if acute_rows.any? %>
  <section data-acute-efficacy>
    <h2 class="text-2xl font-semibold text-fg"><%= t("stats.treatments.acute_title") %> <%= render "shared/info", text: t("stats.treatments.acute_hint"), more: numbers_path(anchor: "acute") %></h2>
    <%# Phones: one stacked block per medication; wider screens: the table %>
    <ul class="mt-4 divide-y divide-line rounded-2xl border border-line bg-surface sm:hidden" data-acute-list>
      <% acute_rows.each do |row| %>
        <li class="px-4 py-3">
          <p class="flex items-baseline justify-between gap-3"><span class="font-medium text-fg"><%= row.medication.name %></span><span class="text-sm text-fg-muted tabular-nums"><%= t("stats.treatments.intakes_count", count: row.intakes) %></span></p>
          <p class="text-sm text-fg-secondary tabular-nums"><%= t("now.effects.none") %> <%= row.none %> · <%= t("now.effects.partial") %> <%= row.partial %> · <%= t("stats.treatments.good_short") %> <%= row.good %></p>
          <p class="text-sm <%= row.verdict == :not_working ? 'font-semibold text-advised-text' : 'text-fg-secondary' %>"><%= t("stats.treatments.verdicts.#{row.verdict}") %></p>
        </li>
      <% end %>
    </ul>
    <div class="mt-4 hidden overflow-x-auto rounded-2xl border border-line bg-surface sm:block">
      <table class="w-full text-left text-sm">
        <thead class="text-xs uppercase tracking-wide text-fg-muted">
          <tr>
            <th class="px-4 py-3 font-semibold"><%= t("stats.treatments.medication") %></th>
            <th class="px-3 py-3 text-center font-semibold"><%= t("stats.treatments.intakes") %></th>
            <th class="px-3 py-3 text-center font-semibold"><%= t("now.effects.none") %></th>
            <th class="px-3 py-3 text-center font-semibold"><%= t("now.effects.partial") %></th>
            <th class="px-3 py-3 text-center font-semibold"><%= t("stats.treatments.good_short") %></th>
            <th class="px-4 py-3 font-semibold"><%= t("stats.treatments.verdict") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line tabular-nums">
          <% acute_rows.each do |row| %>
            <tr data-medication="<%= row.medication.name %>" data-verdict="<%= row.verdict %>">
              <th scope="row" class="px-4 py-3 font-medium text-fg"><%= row.medication.name %></th>
              <td class="px-3 py-3 text-center"><%= row.intakes %></td>
              <td class="px-3 py-3 text-center"><%= row.none %></td>
              <td class="px-3 py-3 text-center"><%= row.partial %></td>
              <td class="px-3 py-3 text-center"><%= row.good %></td>
              <td class="px-4 py-3 text-fg-secondary <%= 'font-semibold text-advised-text' if row.verdict == :not_working %>"><%= t("stats.treatments.verdicts.#{row.verdict}") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if delay %>
      <p class="mt-3 text-sm text-fg-secondary" data-delay><%= t("stats.treatments.delay", minutes: duration_label(delay[:minutes]), count: delay[:attacks]) %></p>
    <% end %>
  </section>
<% end %>

<% if preventive_rows.any? %>
  <section data-preventives>
    <h2 class="text-2xl font-semibold text-fg"><%= t("stats.treatments.preventive_title") %> <%= render "shared/info", text: t("stats.treatments.preventive_hint"), more: numbers_path(anchor: "preventive") %></h2>
    <ul class="mt-4 space-y-3">
      <% preventive_rows.each do |row| %>
        <% period = row.period %>
        <li class="rounded-2xl border border-line bg-surface p-4" data-period="<%= period.id %>">
          <p class="font-medium text-fg"><%= period.medication.name %><%= " · #{period.dose}" if period.dose %></p>
          <p class="text-sm text-fg-secondary">
            <%= l(period.started_on, format: :long) %> → <%= period.current? ? t("treatment_periods.ongoing") : l(period.ended_on, format: :long) %>
            · <%= t("treatment_periods.duration", count: period.days) %>
            <%= "· #{t("treatment_periods.reasons.#{period.stop_reason}")}" if period.stop_reason %>
          </p>
          <% if row.before && row.after %>
            <p class="mt-1 text-sm text-fg" data-comparison>
              <%= t("stats.treatments.before_after", before: number_with_precision(row.before, precision: 1, strip_insignificant_zeros: true), after: number_with_precision(row.after, precision: 1, strip_insignificant_zeros: true)) %>
              <% if row.drop %>
                <span class="font-semibold <%= row.responder? ? 'text-link' : 'text-fg-secondary' %>"><%= t("stats.treatments.drop", percent: (row.drop * 100).round) %></span>
              <% end %>
            </p>
          <% elsif period.days < TreatmentInsights::WINDOW_DAYS %>
            <p class="mt-1 text-sm text-fg-muted"><%= t("stats.treatments.too_early") %></p>
          <% else %>
            <p class="mt-1 text-sm text-fg-muted"><%= t("stats.treatments.no_history") %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if link %>
  <section data-menstrual>
    <h2 class="text-2xl font-semibold text-fg"><%= t("stats.treatments.menstrual_title") %> <%= render "shared/info", text: t("stats.treatments.menstrual_hint"), more: numbers_path(anchor: "menstrual") %></h2>
    <p class="mt-2 text-sm text-fg-secondary">
      <%= t("stats.treatments.menstrual_summary", with_attack: link.with_attack, cycles: link.cycles) %>
      <%= t("stats.treatments.menstrual_pure") if link.pure? %>
    </p>
  </section>
<% end %>
