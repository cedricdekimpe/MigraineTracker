<% content_for :title, t('stats.title') %>

<div>

  <section class="flex flex-col gap-6">
  <header class="rounded-2xl border border-ink-200 bg-paper p-6">
    <h1 class="text-2xl font-semibold text-ink-900"><%= t('stats.title') %></h1>
    <p class="mt-2 text-sm text-ink-500"><%= t('stats.description') %></p>
  </header>

  <!-- Summary Cards -->
  <div class="grid gap-6 sm:grid-cols-3">
    <div class="rounded-2xl border border-ink-200 bg-paper p-6">
      <p class="text-sm font-medium text-ink-500"><%= t('stats.total_migraines') %></p>
      <p class="mt-2 text-3xl font-semibold text-ink-900"><%= @total_episodes %></p>
    </div>
    <div class="rounded-2xl border border-ink-200 bg-paper p-6">
      <p class="text-sm font-medium text-ink-500"><%= t('stats.with_medication') %></p>
      <p class="mt-2 text-3xl font-semibold text-accent-600"><%= @episodes_with_medication %></p>
    </div>
    <div class="rounded-2xl border border-ink-200 bg-paper p-6">
      <p class="text-sm font-medium text-ink-500"><%= t('stats.without_medication') %></p>
      <p class="mt-2 text-3xl font-semibold text-ink-600"><%= @episodes_without_medication %></p>
    </div>
  </div>

  <!-- Migraines Over Time Chart -->
  <div class="rounded-2xl border border-ink-200 bg-paper p-6">
    <h2 class="mb-4 text-lg font-semibold text-ink-900"><%= t('stats.over_time_title') %></h2>
    <%= render "bars", name: "monthly", rows: @monthly_data %>
  </div>

  <!-- Day of Week Chart -->
  <div class="rounded-2xl border border-ink-200 bg-paper p-6">
    <h2 class="mb-4 text-lg font-semibold text-ink-900"><%= t('stats.day_of_week_title') %></h2>
    <%= render "bars", name: "day-of-week", rows: @day_of_week_data %>
  </div>

  <!-- Triggers -->
  <div class="rounded-2xl border border-ink-200 bg-paper p-6" data-triggers>
    <h2 class="text-lg font-semibold text-ink-900"><%= t('stats.triggers_title') %></h2>
    <% if @trigger_data.any? %>
      <p class="mb-4 mt-1 text-sm text-ink-500"><%= t('stats.triggers_description') %></p>
      <ul class="space-y-3">
        <% @trigger_data.each do |name, count| %>
          <% percent = @total_episodes.positive? ? (count * 100.0 / @total_episodes).round : 0 %>
          <li>
            <div class="flex items-baseline justify-between text-sm">
              <span class="font-medium text-ink-800"><%= name %></span>
              <span class="text-ink-500"><%= t('stats.trigger_count', count: count, total: @total_episodes, percent: percent) %></span>
            </div>
            <div class="mt-1 h-2 rounded-full bg-ink-100">
              <div class="h-2 rounded-full bg-accent-500" style="width: <%= percent %>%"></div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-ink-500"><%= t('stats.no_trigger_data') %></p>
    <% end %>
  </div>

  <!-- Medication Usage Chart -->
  <% if @medication_data.any? %>
    <div class="rounded-2xl border border-ink-200 bg-paper p-6">
      <h2 class="mb-4 text-lg font-semibold text-ink-900"><%= t('stats.medication_usage_title') %></h2>
      <%= render "bars", name: "medication", rows: @medication_data %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-ink-200 bg-ink-50 p-6">
      <p class="text-center text-sm text-ink-500"><%= t('stats.no_medication_data') %></p>
    </div>
  <% end %>
  </section>
</div>
