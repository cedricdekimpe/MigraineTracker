<% content_for :title, t("stats.title") %>

<div class="space-y-14">
  <header>
    <h1 class="text-3xl font-semibold text-fg sm:text-4xl"><%= t("stats.title") %> <%= render "shared/info", text: t("stats.description"), more: numbers_path %></h1>
  </header>

  <% if @has_data %>
    <p>
      <%= link_to t("sheet.links.report"), yearly_episodes_path(year: Date.current.year, format: :pdf), data: { turbo: false },
            class: "inline-flex rounded-xl border border-line-control bg-surface px-4 py-2 text-sm font-semibold text-link hover:bg-surface-soft" %>
    </p>
  <% end %>

  <% unless @has_data %>
    <section class="rounded-2xl border border-dashed border-line-control px-6 py-14 text-center">
      <p class="font-display text-xl text-fg"><%= t("stats.empty_title") %></p>
      <p class="mx-auto mt-2 max-w-md text-sm text-fg-secondary"><%= t("stats.empty_hint") %></p>
      <%= link_to t("now.nav"), now_path, class: "mt-6 inline-flex rounded-full bg-crisis px-6 py-3 font-bold text-crisis-on hover:bg-crisis-hover" %>
    </section>
  <% else %>
    <%# --- This month, in the dashed frame and ink of the month, like the paper calendar --- %>
    <section class="rounded-3xl border-2 border-dashed <%= month_panel_class(@month.month) %> p-5 sm:p-8" data-month-summary>
      <h2 class="text-2xl font-semibold text-fg"><%= l(@month.month, format: :month_year) %></h2>

      <dl class="mt-5 grid grid-cols-3 gap-4 sm:mt-8 sm:gap-8">
        <div>
          <dd class="font-display text-4xl font-semibold leading-none text-fg tabular-nums sm:text-6xl" data-figure="pain-days"><%= @month.pain_days %></dd>
          <dt class="mt-2 text-sm leading-5 text-fg-secondary"><%= t("stats.pain_days", count: @month.pain_days) %></dt>
          <dd class="mt-1 text-xs text-fg-secondary sm:text-sm"><%= t("stats.of_which_migraine", count: @month.migraine_days) %></dd>
          <dd class="mt-1 text-xs text-fg-secondary sm:text-sm" data-figure="severe-days"><%= t("stats.severe_days", count: @month.severe_days) %></dd>
        </div>
        <div>
          <dd class="font-display text-4xl font-semibold leading-none text-fg tabular-nums sm:text-6xl" data-figure="acute-days"><%= @month.any_acute_days %></dd>
          <dt class="mt-2 text-sm leading-5 text-fg-secondary"><%= t("stats.acute_days", count: @month.any_acute_days) %></dt>
          <dd class="hidden text-sm text-fg-secondary sm:block"><%= t("stats.triptan_split", triptan: @month.triptan_days, acute: @month.non_triptan_days) %></dd>
        </div>
        <div>
          <dd class="font-display text-4xl font-semibold leading-none text-fg tabular-nums sm:text-6xl" data-figure="average"><%= @average ? number_with_precision(@average, precision: 1, strip_insignificant_zeros: true) : "–" %></dd>
          <dt class="mt-2 text-sm leading-5 text-fg-secondary"><%= t("stats.average_label") %></dt>
          <dd class="hidden text-sm text-fg-secondary sm:block"><%= @average ? t("stats.average_hint") : t("stats.no_average") %></dd>
        </div>
      </dl>
      <% if @month.aura_days.positive? %>
        <p class="mt-6 text-sm text-fg-secondary"><%= t("stats.aura_days", count: @month.aura_days) %></p>
      <% end %>
    </section>

    <%# --- Acute treatment days against the overuse thresholds --- %>
    <section data-overuse="<%= @month.overuse_status %>">
      <h2 class="text-2xl font-semibold text-fg"><%= t("stats.overuse.title") %> <%= render "shared/info", text: t("stats.overuse.hint"), more: numbers_path(anchor: "limits") %></h2>

      <div class="mt-6 space-y-6">
        <% [[:triptan, @month.triptan_days, MonthlyOverview::TRIPTAN_LIMIT, MonthlyOverview::TRIPTAN_ADVISED], [:combination, @month.combination_days, MonthlyOverview::COMBINATION_LIMIT, MonthlyOverview::COMBINATION_ADVISED], [:acute, @month.acute_days, MonthlyOverview::ACUTE_LIMIT, MonthlyOverview::ACUTE_ADVISED]].each do |kind, days, limit, advised| %>
          <% next if kind == :combination && days.zero? %>
          <div data-meter="<%= kind %>">
            <div class="mb-2 flex items-baseline justify-between text-sm">
              <span class="font-medium text-fg"><%= t("stats.overuse.#{kind}") %></span>
              <span class="text-fg-secondary"><%= t("stats.overuse.days_of_limit", days: days, limit: limit) %></span>
            </div>
            <%= limit_meter(days: days, limit: limit, advised: advised) %>
          </div>
        <% end %>
        <% if @month.mixed? %>
          <p class="text-sm text-fg-secondary"><%= t("stats.overuse.mixed", days: @month.any_acute_days, limit: MonthlyOverview::MIXED_LIMIT) %></p>
        <% end %>
        <% if @month.heavy_weeks.positive? %>
          <p class="text-sm text-fg-secondary" data-heavy-weeks><%= t("stats.overuse.heavy_weeks", count: @month.heavy_weeks) %></p>
        <% end %>
      </div>

      <% tone = { ok: "bg-ok-surface text-ok-text", advised: "bg-advised-surface text-advised-text", over: "bg-over-surface text-over-text", sustained: "bg-sustained-surface text-sustained-text" }.fetch(@month.overuse_status) %>
      <p class="mt-6 rounded-2xl border px-4 py-3 text-sm font-medium <%= tone %>" role="status"><%= t("stats.overuse.status_#{@month.overuse_status}") %></p>
    </section>

    <%= render "stats/treatments", insights: @insights, chronic_streak: @chronic_streak, month: @month %>

    <%# --- Twelve months, one column per month in the paper's yellow / pink / blue --- %>
    <section>
      <h2 class="text-2xl font-semibold text-fg"><%= t("stats.pain_chart_title") %></h2>
      <div class="mt-5" data-chart="pain-days">
        <%= month_columns(@overview.months, label: t("stats.pain_chart_title"), segments: ->(m) { [m.migraine_days, m.headache_days] }) %>
      </div>
      <p class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-fg-secondary">
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded-sm bg-chart-a"></i><%= t("stats.legend_migraine") %></span>
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded-sm bg-chart-b"></i><%= t("stats.legend_headache") %></span>
      </p>
      <table class="sr-only">
        <caption><%= t("stats.pain_chart_title") %></caption>
        <thead><tr><th><%= t("stats.table_month") %></th><th><%= t("stats.legend_migraine") %></th><th><%= t("stats.legend_headache") %></th></tr></thead>
        <tbody>
          <% @overview.months.each do |m| %>
            <tr><td><%= l(m.month, format: :month_year) %></td><td><%= m.migraine_days %></td><td><%= m.headache_days %></td></tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <section>
      <h2 class="text-2xl font-semibold text-fg"><%= t("stats.medication_chart_title") %></h2>
      <div class="mt-5" data-chart="acute-days">
        <%= month_columns(@overview.months, label: t("stats.medication_chart_title"),
              segments: ->(m) { [m.triptan_days, m.non_triptan_days] },
              threshold: MonthlyOverview::MIXED_LIMIT, threshold_label: t("stats.threshold_label", days: MonthlyOverview::MIXED_LIMIT)) %>
      </div>
      <p class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-fg-secondary">
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded-sm bg-chart-a"></i><%= t("stats.overuse.triptan") %></span>
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded-sm bg-chart-b"></i><%= t("stats.overuse.acute") %></span>
      </p>
    </section>

    <%# --- What gets ticked: a list of what comes up, not a verdict --- %>
    <%= render "stats/daily_factors", factors: @factors %>

    <p class="border-t border-line pt-4 text-xs text-fg-muted"><%= t("stats.disclaimer") %></p>
  <% end %>
</div>
