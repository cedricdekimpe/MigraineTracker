<%# Horizontal bars, no JavaScript. rows: [[label, count], ...]; every row keeps data-label / data-count for tests and scripts. %>
<% max = [rows.map(&:last).max.to_i, 1].max %>
<ul class="space-y-2" data-bars="<%= name %>">
  <% rows.each do |label, count| %>
    <li data-label="<%= label %>" data-count="<%= count %>">
      <div class="flex items-baseline justify-between text-sm">
        <span class="font-medium text-slate-800"><%= label %></span>
        <span class="text-slate-500"><%= count %></span>
      </div>
      <div class="mt-1 h-2 rounded-full bg-slate-100">
        <div class="h-2 rounded-full bg-emerald-500" style="width: <%= (count * 100.0 / max).round %>%"></div>
      </div>
    </li>
  <% end %>
</ul>
