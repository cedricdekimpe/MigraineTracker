{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["/(fr|en)/episodes/new$", "/(fr|en)/episodes/[0-9]+/edit$"],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": ["/(fr|en)/now$", "/(fr|en)/now/"],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
