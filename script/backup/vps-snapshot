#!/bin/sh
# Runs ON THE VPS (installed as ~/bin/migraine-snapshot, called through vps-gate): writes a consistent copy of the
# production database into ~/backups-migraine, for the homelab to pull. Needs docker (group) and the running container.
set -eu
umask 077

dir="$HOME/backups-migraine"
container=$(docker ps -qf name=my_migraine_manager-web | head -1)
[ -n "$container" ] || { echo "migraine container not running" >&2; exit 1; }

mkdir -p "$dir/db"
snapshot=/tmp/snapshot.sqlite3

# VACUUM INTO takes a consistent copy without stopping the site (WAL mode).
docker exec "$container" rm -f "$snapshot"
docker exec "$container" bundle exec ruby -e '
  require "sqlite3"
  db = SQLite3::Database.new("/rails/storage/production.sqlite3")
  db.execute("VACUUM INTO ?", ["/tmp/snapshot.sqlite3"])
  check = SQLite3::Database.new("/tmp/snapshot.sqlite3").get_first_value("PRAGMA integrity_check")
  abort "integrity_check: #{check}" unless check == "ok"
'
name="production-$(date +%F).sqlite3"
docker cp "$container:$snapshot" "$dir/db/$name.new"
docker exec "$container" rm -f "$snapshot"
mv "$dir/db/$name.new" "$dir/db/$name"
# only the last three snapshots stay on the VPS
ls -1t "$dir"/db/production-*.sqlite3 | tail -n +4 | xargs -r rm -f

echo "snapshot ok: $name"
