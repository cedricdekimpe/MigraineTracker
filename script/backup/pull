#!/bin/sh
# Runs ON THE HOMELAB (cron, once a day): asks the VPS for a fresh snapshot, then mirrors ~/backups-migraine from it.
# borgmatic (config /etc/borgmatic.d/migrainetracker.yaml, 30 days) archives the destination.
# Optional: PUSH_URL_FILE holds an Uptime Kuma push URL, pinged after a success.
set -eu

host=${BACKUP_HOST:-deploy@77.42.44.3}
key=${BACKUP_KEY:-$HOME/.ssh/migraine_backup_ed25519}
dest=${BACKUP_DEST:-$HOME/backups/migrainetracker}
push_file=${PUSH_URL_FILE:-$HOME/.config/migrainetracker/backup-push-url}
ssh_opts="-i $key -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15"

mkdir -p "$dest"
chmod 700 "$dest"
ssh $ssh_opts "$host" snapshot
# trailing "/" = the whole ~/backups-migraine of the VPS, which rrsync makes the root
rsync -a --delete -e "ssh $ssh_opts" "$host:/" "$dest/"

# the copy must be a readable database before we call it a backup
latest=$(ls -1t "$dest"/db/production-*.sqlite3 | head -1)
python3 -c 'import sqlite3, sys; sys.exit(0 if sqlite3.connect(sys.argv[1]).execute("PRAGMA integrity_check").fetchone()[0] == "ok" else "integrity_check failed")' "$latest"

echo "backup ok: $(basename "$latest"), $(du -sh "$dest" | cut -f1)"
[ -f "$push_file" ] && curl -fsS -m 15 "$(cat "$push_file")" >/dev/null || true
